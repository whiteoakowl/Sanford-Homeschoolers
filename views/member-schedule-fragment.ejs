<%# Injected into #schedule-dialog-<id> by public/js/members-dialogs.js, via
    the shared public/js/fragment-dialog.js helper - fetched only when the
    Schedule button is actually clicked, not server-rendered for every row
    on the Members page (see admin-members.ejs and
    routes/admin-members.js's /members/:id/schedule-fragment for why).
    Same shared member schedule table every other member schedule
    surface uses (partials/member-schedule-table.ejs), name heading
    included, with the same Export/PDF/Print row. %>
<div class="member-schedule-dialog-body">
  <%- include('partials/member-schedule-table', { tables: scheduleTables, headingLevel: 2, classHref: function (id) { return '/admin/class-schedule/classes/' + id + '/manage'; } }) %>
</div>
<div class="notes-dialog-actions">
  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
  <%- include('partials/member-schedule-actions', {
    exportHref: '/admin/schedule/export.csv?memberId=' + member.id,
    pdfHref: '/admin/schedule/download.pdf?memberId=' + member.id,
    printHref: '/admin/schedule/print?memberId=' + member.id,
  }) %>
</div>
