<!doctype html>
<html lang="en" class="<%= smoothScroll ? 'wx-smooth' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <%# Empty unless signed in - public/js/csrf.js no-ops on a blank token. %>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>" />
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>" /><% } %>
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow" /><% } %>
  <link rel="canonical" href="<%= canonical %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:url" content="<%= canonical %>" />
  <% if (description) { %><meta property="og:description" content="<%= description %>" /><% } %>
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>" /><% } %>
  <link rel="icon" href="<%= faviconUrl %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <% if (fontsHref) { %><link href="<%= fontsHref %>" rel="stylesheet" /><% } %>
  <link rel="stylesheet" href="/css/site.css" />
  <%# Generated from the validated site document only (numbers, palette
      colors, the fixed font list) - never free text - so it's safe raw.
      See public/js/site-render.js's pageCss/designCss. %>
  <style><%- siteCss %></style>
  <script>document.documentElement.classList.add('wx-js');</script>
  <% if (analyticsId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= analyticsId %>"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '<%= analyticsId %>');</script>
  <% } %>
  <script src="/js/csrf.js" defer></script>
  <script src="/js/site-runtime.js" defer></script>
  <%# A real request: "Homepage mobile. Log in button, the text should
      shrink to fit to stay on one row clean in button box." Same
      generic measure-and-shrink helper the Classes grid/Grade Level
      Report already use - shrinkAll() targets the Log In/My Portals
      button's own box (see that script's own comment). %>
  <script src="/js/shrink-title-to-fit.js" defer></script>
</head>
<body class="wx-public<%= headerSticky ? ' has-sticky-header' : '' %>">
  <a class="wx-skip" href="#main-content">Skip to content</a>
  <% if (isPreview) { %><div class="wx-preview-banner">Preview &mdash; not the live site</div><% } %>
  <div id="wx-site">
    <%- bodyHtml %>
  </div>
  <% if (cookieBanner) { %>
    <div class="wx-cookie" role="region" aria-label="Cookie notice" hidden data-wx-cookie>
      <p><%= cookieBanner.text || 'We use cookies to understand how our site is used.' %><% if (cookieBanner.policyUrl) { %> <a href="<%= cookieBanner.policyUrl %>">Learn more</a><% } %></p>
      <button type="button" class="wx-btn" data-wx-cookie-accept><%= cookieBanner.buttonLabel || 'OK' %></button>
    </div>
  <% } %>
</body>
</html>
