<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Classroom Dashboard</h1>

    <%# A real request: "Filter button should turn into a pill slider
        toggle switching from co-op classes to homeschool family
        classes." Replaces the old Filter popover's All/Co-op/Family
        <select> with the same pill-toggle component the Co-op Schedule
        day switcher already uses (.day-toggle/.day-toggle-option,
        styles.css) - a plain two-option "slide" between Co-op Classes
        and Homeschool Family Classes, each a real page link. %>
    <div class="day-toggle no-print" role="group" aria-label="Co-op or homeschool family classes">
      <a class="day-toggle-option<%= type !== 'family' ? ' active' : '' %>" href="/student/classes/dashboard?type=coop">Co-op Classes</a>
      <a class="day-toggle-option<%= type === 'family' ? ' active' : '' %>" href="/student/classes/dashboard?type=family">Homeschool Family Classes</a>
    </div>

    <% if (days.length === 0 && familyClasses.length === 0) { %>
      <p class="roster-empty">You're not enrolled in any classes yet.</p>
    <% } else { %>
      <% if (days.length > 0) { %>
        <h2>Co-op Classes</h2>
        <% days.forEach(function(d) { %>
          <h3><%= dayLabels[d] %></h3>
          <div class="class-dash-grid">
            <% byDay[d].forEach(function(c) { %>
              <div class="class-dash-card">
                <div class="class-dash-card-color-bar" style="background:<%= c.color %>"></div>
                <div class="class-dash-card-body">
                  <% if (c.classImageUrl) { %>
                    <img class="class-dash-card-image" src="<%= c.classImageUrl %>" alt="" />
                  <% } else { %>
                    <span class="class-dash-card-image class-dash-card-image-placeholder"><svg class="icon"><use href="#icon-graduation-cap"/></svg></span>
                  <% } %>
                  <div class="class-dash-card-text">
                    <h3 class="class-dash-card-title"><%= c.class_name %></h3>
                    <p class="class-dash-card-meta"><%= c.timeLabel %></p>
                    <p class="class-dash-card-meta"><%= c.room || 'No room set' %></p>
                    <p class="class-dash-card-meta"><%= c.teacherNames.length ? c.teacherNames.join(', ') : 'No teacher assigned' %></p>
                  </div>
                </div>
                <div class="class-dash-card-actions">
                  <a class="roster-action-btn" href="/student/classes/dashboard/<%= c.id %>">View Class</a>
                </div>
              </div>
            <% }); %>
          </div>
        <% }); %>
      <% } %>

      <%# A real request: "when you click on a family class it has the
          same tabs as the co-op classes. Details, lessons, grades."
          Same .class-dash-card shape as the Co-op section above (a real
          request: "class cards should look like co-op class cards") -
          family_school_classes has no color/image/day-time of its own
          (see that table's own migration comment), so every card here
          uses the same fixed accent bar and a Family Homeschooling-
          flavored placeholder icon instead. %>
      <% if (familyClasses.length > 0) { %>
        <h2>Homeschool Family Classes</h2>
        <div class="class-dash-grid">
          <% familyClasses.forEach(function(c) { %>
            <div class="class-dash-card">
              <div class="class-dash-card-color-bar" style="background:var(--accent)"></div>
              <div class="class-dash-card-body">
                <span class="class-dash-card-image class-dash-card-image-placeholder"><svg class="icon"><use href="#icon-home-heart"/></svg></span>
                <div class="class-dash-card-text">
                  <h3 class="class-dash-card-title"><%= c.class_name %></h3>
                  <p class="class-dash-card-meta">Homeschool Family Class</p>
                  <% if (c.description) { %><p class="class-dash-card-meta"><%= c.description %></p><% } %>
                </div>
              </div>
              <div class="class-dash-card-actions">
                <a class="roster-action-btn" href="/student/family-school/classes/<%= c.id %>">View Class</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>
  </main>
</body>
</html>
