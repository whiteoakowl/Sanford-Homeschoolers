<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Homepage</h1>

    <%# Item 6: "remove accounts by role counting, remove user settings -
        user settings should be under the gear setting icon at the top of
        the page [already true - see routes/main-admin.js's own /settings
        redirect and the gear dropdown in partials/portal-nav.ejs]. There
        should be a count display for number of parents, students,
        families, teachers and admins. Then there should be a 2nd count
        display for pending requests... each name should be able to click
        and go straight to that request page." A later request dropped the
        "Main Admin" title + description ("should be called Homepage,
        remove the description") and renamed this section "People" ->
        "Members". A further request: "main admin, homepage, member count.
        should look like the member count on co-op admin portal homepage" -
        reuses the exact same .family-student-counts-card/-row markup and
        classes as the Co-op Admin dashboard's own "Co-op Member Counts"
        card (views/admin-dashboard.ejs) instead of the plain numbers-in-
        a-row .totals-card grid this used to be. That card splits into a
        Monday/Wednesday column pair because its 3 counts are genuinely
        day-scoped; these 5 aren't split by anything, so they're just one
        flat list of rows here - same icon-circle+label+value row shape,
        one consistent blue accent throughout instead of an orange/blue
        pair standing in for two different days. %>
    <%# A real request: "Main admin homepage should look like this image.
        Use the colors on the homepage for co-op admin portal" - a Members
        card (5 counts side by side, each with an icon circle) and a
        Pending Requests card (a 3 x 2 grid of links), both with View All.
        Colors are the Co-op Admin dashboard's own orange and blue
        (--orange-bg / --accent-dark and --brand-soft / --brand-dark). %>
    <%
    var mahMembers = [
      { icon: 'home', label: 'Families', value: familyCount, href: '/main-admin/members' },
      { icon: 'users', label: 'Parents', value: parentCount, href: '/main-admin/members' },
      { icon: 'graduation-cap', label: 'Students', value: studentCount, href: '/main-admin/members' },
      { icon: 'book', label: 'Teachers', value: teacherCount, href: '/main-admin/members' },
      { icon: 'shield', label: 'Admins', value: adminCount, href: '/main-admin/admins' },
    ];
    var mahRequests = [
      { icon: 'user-plus', label: 'Membership Requests', value: pendingCount, href: '/main-admin/members?tab=approvals' },
      { icon: 'calendar-check', label: 'Event Requests', value: eventRequestsCount, href: '/main-admin/events?tab=requests' },
      { icon: 'smile', label: 'Babysitter Approvals', value: babysitterApprovalsCount, href: '/main-admin/babysitters?tab=approvals' },
      { icon: 'camera', label: 'Photo Submissions', value: photoSubmissionsCount, href: '/main-admin/photos#pending-photos' },
      { icon: 'store', label: 'Business Directory Requests', value: directoryRequestsCount, href: '/main-admin/directory?tab=requests' },
      { icon: 'tag', label: 'Classifieds Requests', value: classifiedsRequestsCount, href: '/main-admin/classifieds?tab=requests' },
    ];
    %>
    <section class="mah-card">
      <div class="mah-card-header mah-card-header-orange">
        <svg class="icon"><use href="#icon-users"/></svg>
        <h2>Members</h2>
        <a class="mah-viewall" href="/main-admin/members">View All <svg class="icon"><use href="#icon-arrow-right"/></svg></a>
      </div>
      <div class="mah-members">
        <% mahMembers.forEach(function(m) { %>
          <a class="mah-member" href="<%= m.href %>">
            <span class="mah-member-icon"><svg class="icon"><use href="#icon-<%= m.icon %>"/></svg></span>
            <span class="mah-member-value"><%= m.value %></span>
            <span class="mah-member-label"><%= m.label %></span>
          </a>
        <% }); %>
      </div>
    </section>

    <section class="mah-card">
      <div class="mah-card-header mah-card-header-blue">
        <svg class="icon"><use href="#icon-hourglass"/></svg>
        <h2>Pending Requests</h2>
        <a class="mah-viewall" href="/main-admin/members?tab=approvals">View All <svg class="icon"><use href="#icon-arrow-right"/></svg></a>
      </div>
      <div class="mah-requests">
        <% mahRequests.forEach(function(r) { %>
          <a class="mah-request<%= r.value > 0 ? ' mah-request-has' : '' %>" href="<%= r.href %>">
            <span class="mah-request-icon"><svg class="icon"><use href="#icon-<%= r.icon %>"/></svg></span>
            <span class="mah-request-count"><%= r.value %></span>
            <span class="mah-request-label"><%= r.label %></span>
          </a>
        <% }); %>
      </div>
    </section>
  </main>
</body>
</html>
