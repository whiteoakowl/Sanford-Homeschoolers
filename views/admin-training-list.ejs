<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Training</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <button type="button" class="roster-action-btn" onclick="document.getElementById('new-training-dialog').showModal()">+ New Training</button>
      </div>
    </div>

    <% if (trainings.length === 0) { %>
      <p class="roster-empty">No trainings yet &mdash; create one above.</p>
    <% } %>

    <div class="training-card-grid">
      <% trainings.forEach(function(t) { %>
        <%- include('partials/training-card', { a: { id: t.id, title: t.title, imageKey: t.image_key, lessonCount: t.lessonCount, estimatedMinutes: t.estimated_minutes, trainingStatus: t.status, assignmentCount: t.assignmentCount, passingScore: t.passing_score }, adminBase: '/admin' }) %>
      <% }); %>
    </div>

    <dialog id="new-training-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/training">
        <h3>New Training</h3>
        <label>Title
          <input type="text" name="title" placeholder="e.g. New Employee Orientation" required />
        </label>
        <label>Description
          <textarea name="description" rows="3" placeholder="Short description (optional)"></textarea>
        </label>
        <label>Estimated Time (minutes)
          <input type="number" name="estimatedMinutes" min="1" placeholder="45" />
        </label>
        <label>Passing Score (%)
          <input type="number" name="passingScore" min="0" max="100" value="80" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
