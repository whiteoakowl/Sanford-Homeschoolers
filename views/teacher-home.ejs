<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Co-op Teacher Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Welcome, <%= member.name %></h1>

    <section class="portal-dashboard-section">
      <h2>Announcements</h2>
      <% if (announcements.length === 0) { %>
        <p class="roster-empty">No announcements right now.</p>
      <% } else { %>
        <div class="site-announcement-list">
          <% announcements.forEach(function(a) { %>
            <div class="site-announcement-card">
              <span class="site-announcement-date">
                <%= a.dateLabel %>
                <% if (a.isNew) { %><span class="badge-pill badge-pill-present">New</span><% } %>
              </span>
              <h3><%= a.title %></h3>
              <div class="forum-editable-display"><%- a.body %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <p class="hint">Your classes and their rosters.</p>
    <% if (classes.length === 0) { %>
      <p class="roster-empty">You're not staffed on any classes yet. Contact an admin if this looks wrong.</p>
    <% } else { %>
      <%# A real request: "This is how the class cards should look on the
          teacher portal homepage" - the class photo on the left (or a blue
          panel when none is uploaded), then the class name in a pill, the
          big enrolled count, the day and time, grades, who it's co-taught
          with, and a View Roster button. %>
      <div class="teacher-class-card-grid">
        <% classes.forEach(function(c) { %>
          <article class="teacher-class-card">
            <div class="teacher-class-card-art">
              <% if (c.classImageUrl) { %>
                <img src="<%= c.classImageUrl %>" alt="" loading="lazy" />
              <% } else { %>
                <span class="teacher-class-card-art-icon" aria-hidden="true"><svg class="icon"><use href="#icon-graduation-cap"/></svg></span>
              <% } %>
            </div>
            <div class="teacher-class-card-body">
              <span class="teacher-class-card-pill"><%= c.class_name %></span>
              <p class="teacher-class-card-count"><span class="teacher-class-card-count-num"><%= c.studentCount %></span><span class="teacher-class-card-count-label">student<%= Number(c.studentCount) === 1 ? '' : 's' %><br />enrolled</span></p>
              <hr class="teacher-class-card-divider" />
              <p class="teacher-class-card-meta"><svg class="icon"><use href="#icon-calendar-check"/></svg><span><%= c.dayLabel %><% if (c.timeLabel) { %><br /><%= c.timeLabel %><% } %></span></p>
              <p class="teacher-class-card-meta"><svg class="icon"><use href="#icon-graduation-cap"/></svg><span><% if (!c.gradeLabel) { %>All grades<% } else if (/grade/i.test(c.gradeLabel)) { %><%= c.gradeLabel %><% } else { %>Grades <%= c.gradeLabel %><% } %></span></p>
              <% if (c.coTeacherNames.length) { %>
                <p class="teacher-class-card-meta"><svg class="icon"><use href="#icon-users"/></svg><span>Co-taught with <strong><%= c.coTeacherNames.join(', ') %></strong></span></p>
              <% } %>
              <a class="teacher-class-card-btn" href="/teacher/classes/<%= c.id %>">View Roster <svg class="icon"><use href="#icon-arrow-right"/></svg></a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
