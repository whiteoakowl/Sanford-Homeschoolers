<!doctype html>
<html lang="en">
<head>
  <%# A real request: "the download should be a pdf of exactly how it
      would also look when printing." utils/pdfRender.js renders this
      exact view (via req.app.render(), never through a real HTTP
      request) to build the Download PDF - pdfBaseUrl is only ever set
      for that internal render, since Chromium otherwise has no "current
      page URL" of its own to resolve this page's relative asset URLs
      (/css/styles.css, /img/logo.png) against. A real person visiting
      this same page in their own browser (the Print button's own
      target) never sets it, so the page's own URL already does that
      job and this <base> tag is simply absent. %>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page">
  <%# Shared by every member schedule Print/PDF (Co-op Admin, Main Admin,
      and a member's own My Profile > Schedules) - portalTitle set means
      a portal caller, which gets the portal nav instead of Co-op Admin's
      own sidebar. %>
  <% if (typeof portalTitle !== 'undefined' && portalTitle) { %>
    <%- include('partials/portal-nav', { portalTitle }) %>
  <% } else { %>
    <%- include('partials/admin-nav') %>
  <% } %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Print Schedules</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <%# A real request: "Each member's schedule should look like this
        image" - the same shared table every on-screen member schedule
        renders (partials/member-schedule-table.ejs), one member after
        another, each member's own section kept together on one page
        where it fits (.member-schedule-print-list's break-inside). %>
    <div class="member-schedule-print-list">
      <% if (tables.length === 0) { %>
        <p class="roster-empty">No schedules match your filters.</p>
      <% } else { %>
        <%- include('partials/member-schedule-table', { tables, classHref: null }) %>
      <% } %>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
