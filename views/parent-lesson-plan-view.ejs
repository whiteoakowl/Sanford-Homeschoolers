<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# A real request: "There should be a view button to view the
        lesson plan entirely in view mode." Read-only preview of a Lesson
        Plan Library plan, reached from its own View button on views/
        parent-family-school-classes.ejs's own Lesson Plan Library tab -
        lets a parent see everything inside a plan before adding it to
        their Family Class List, same read-only content rendering
        views/partials/family-school-content-manage.ejs's own
        sourcePlanLocal branch already uses once a plan is actually
        linked into a class, just without a class/lesson to attach to
        yet. %>
    <p class="no-print"><a href="/parent/family-school/classes?tab=availableLessonPlans">&larr; Back to Lesson Plan Library</a></p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2><%= plan.title %></h2>
      </div>
      <% if (plan.description) { %><p class="hint"><%= plan.description %></p><% } %>
      <form method="POST" action="/parent/family-school/classes/from-lesson-plan">
        <input type="hidden" name="lessonPlanId" value="<%= plan.id %>" />
        <button type="submit" class="primary-btn">Add to Family Class List</button>
      </form>
      <%# Parents only ever edit their own family's private copy - Edit
          on a library plan makes that copy first (POST .../copy). %>
      <% if (isFamilyCopy) { %>
        <p class="hint">This is your family's own copy - changes only affect your family.</p>
        <p><a class="roster-action-btn" href="/parent/family-school/lesson-plans/<%= plan.id %>/edit">Edit Lesson Plan</a></p>
      <% } else if (plan.allow_member_edit) { %>
        <% if (plan.locked) { %>
          <p class="hint">This lesson plan is locked by an admin, so it can't be edited right now.</p>
        <% } else { %>
          <form method="POST" action="/parent/family-school/lesson-plans/<%= plan.id %>/copy">
            <button type="submit" class="roster-action-btn">Edit for My Family</button>
          </form>
          <p class="hint">Makes your family's own copy to edit. The library version, and every other family's, stays the same.</p>
        <% } %>
      <% } %>
    </div>

    <%- include('partials/lesson-plan-content-readonly', { contentItems }) %>
  </main>
</body>
</html>
