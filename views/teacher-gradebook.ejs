<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Co-op Teacher Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="hint"><a href="/teacher/classes/<%= cls.id %>">&larr; Back to <%= cls.class_name %></a></p>
    <h1><%= assignment.title %> <%- include('partials/lesson-approval-badge', { status: assignment.approval_status }) %></h1>
    <% if (assignment.approval_status === 'rejected') { %>
      <%# A real request: lesson approval should "look and behave the same
          way" as teacher reimbursements - a rejected item opens with the
          admin's message up top and an Edit & Resubmit action. %>
      <div class="alert alert-error" id="lesson-rejection">
        <strong>Rejected by a Co-op Admin</strong>
        <% if (assignment.review_note) { %><div class="plain-text-display"><%= assignment.review_note %></div><% } %>
        <div class="roster-btn-row" style="margin-top: 0.5rem;">
          <a class="roster-action-btn" href="#lesson-details">Edit &amp; Resubmit</a>
        </div>
      </div>
    <% } %>
    <% if (assignment.description) { %><p class="hint plain-text-display"><%= assignment.description %></p><% } %>
    <p class="hint">
      <% if (assignment.points_possible != null) { %>Out of <%= assignment.points_possible %> points<% } %>
    </p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Approval</h2>
        <%- include('partials/lesson-approval-badge', { status: assignment.approval_status }) %>
      </div>
      <% if (assignment.approval_status === 'draft') { %>
        <p class="hint">Students can't see this lesson yet. Add its content, then submit it for a Co-op Admin to approve.</p>
      <% } else if (assignment.approval_status === 'pending') { %>
        <p class="hint">Waiting for a Co-op Admin to review this lesson. Students will see it once it's approved.</p>
      <% } else if (assignment.approval_status === 'rejected') { %>
        <p class="hint">Edit the lesson below to address the message above, then resubmit it. It goes back to Pending.</p>
      <% } else { %>
        <p class="hint">Approved - visible to students enrolled in this class. Edits you make keep it approved.</p>
      <% } %>
      <% if (assignment.approval_status === 'draft' || assignment.approval_status === 'rejected') { %>
        <form method="POST" action="/teacher/assignments/<%= assignment.id %>/submit-approval">
          <button type="submit" class="primary-btn"><%= assignment.approval_status === 'rejected' ? 'Resubmit for Approval' : 'Submit for Approval' %></button>
        </form>
      <% } %>
      <% var rejections = approvalEvents.filter(function(e) { return e.action === 'rejected'; }); %>
      <% if (rejections.length) { %>
        <h3>Rejection History</h3>
        <ul>
          <% rejections.slice().reverse().forEach(function(e) { %>
            <li><span class="hint"><%= e.createdAtLabel %><% if (e.actor_name) { %> &middot; <%= e.actor_name %><% } %></span><div class="plain-text-display"><%= e.message %></div></li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <%- include('partials/lesson-content-manage', { basePath: '/teacher', assignment, contentItems }) %>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Grades</h2>
      </div>

    <% if (rows.length === 0) { %>
      <p class="roster-empty">No students enrolled in this class yet.</p>
    <% } else { %>
      <form method="POST" action="/teacher/assignments/<%= assignment.id %>/grades">
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table table-stack-mobile">
            <thead>
              <tr>
                <th>Student</th>
                <th>Points Earned</th>
                <th>Feedback</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(r) { %>
                <tr>
                  <td class="roster-name-col table-stack-heading"><%= r.student_name %></td>
                  <td data-label="Points Earned">
                    <input type="number" name="points_<%= r.student_id %>" min="0" step="0.5" value="<%= r.points_earned != null ? r.points_earned : '' %>" style="width: 6rem;" />
                  </td>
                  <td data-label="Feedback">
                    <input type="text" name="feedback_<%= r.student_id %>" value="<%= r.feedback || '' %>" />
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div style="margin-top: 1rem;">
          <button type="submit" class="primary-btn">Save Grades</button>
        </div>
      </form>
    <% } %>
    </div>
  </main>
  <%# Same fix as views/admin-class-assignment-gradebook.ejs's own - this
      page never loaded forum-editor.js either, so an Assignment Upload/
      Assignment Submission's rich-text body got wiped to blank on save. %>
  <script src="/js/forum-editor.js"></script>
</body>
</html>
