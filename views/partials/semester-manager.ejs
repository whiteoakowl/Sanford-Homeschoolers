<%
// locals: semesters, classDays/classDayLabels (every day of the week the
// "Add a Schedule"/edit checkboxes can offer), classSchedules (every
// class_schedules row - used here only to work out which days each
// semester already covers), backUrl (optional - where each form's own
// POST redirects back to; defaults to the Settings tab). Used by the
// Settings tab's own Semester sub-tab.
const semesterBackUrl = typeof backUrl !== 'undefined' && backUrl ? backUrl : '/admin/settings?tab=semesters';
// classDays is already in calendar order, so filtering it (rather than
// mapping classSchedules directly) gives each semester's own day list
// back in calendar order too, not creation order.
function fmtDue(iso) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
  return m ? m[2] + '/' + m[3] + '/' + m[1] : '';
}
function daysForSemester(semesterId) {
  const covered = new Set(classSchedules.filter(function (cs) { return cs.semester_id === semesterId; }).map(function (cs) { return cs.day_of_week; }));
  return classDays.filter(function (d) { return covered.has(d); });
}
%>
<section class="portal-dashboard-card portal-dashboard-card-wide">
  <h2>Add a Semester</h2>
  <form method="POST" action="/admin/schedule/semesters" class="member-form-grid">
    <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
    <label class="member-form-full">Title
      <input type="text" name="title" placeholder="e.g. Fall 2026" required />
    </label>
    <label class="member-form-full">Class Fees Due Date
      <input type="date" name="feesDueDate" />
      <span class="hint">Every class fee for this semester's classes is billed to the family's account with this due date. Students stay registered whether or not it's paid yet.</span>
    </label>
    <div class="member-form-full">
      <span class="checkbox-group-label">Add a Schedule</span>
      <div class="checkbox-group">
        <% classDays.forEach(function(d) { %>
          <label class="checkbox-option">
            <input type="checkbox" name="days" value="<%= d %>" />
            <%= classDayLabels[d] %>
          </label>
        <% }); %>
      </div>
    </div>
    <div class="member-form-full">
      <button type="submit" class="primary-btn">Add Semester</button>
    </div>
  </form>
</section>

<%# A real request: an archive icon on each semester, an "are you sure"
    popup, Unarchive, and a way to view an archived semester. Archived
    semesters are listed separately below the active ones. %>
<% var archivedSemesters = semesters.filter(function(s) { return s.archived_at; }); %>
<% semesters = semesters.filter(function(s) { return !s.archived_at; }); %>
<section class="portal-dashboard-section">
  <% if (semesters.length === 0) { %>
    <p class="roster-empty">No semesters yet.</p>
  <% } else { %>
    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table semester-list-table">
        <thead>
          <tr><th>Title</th><th>Days</th><th>Fees Due</th><th></th></tr>
        </thead>
        <tbody>
          <% semesters.forEach(function(s) { %>
            <% var semesterDays = daysForSemester(s.id); %>
            <tr>
              <td class="roster-name-col">
                <button type="button" class="semester-title-btn" data-semester-edit-toggle="semester-edit-<%= s.id %>"><%= s.title %></button>
              </td>
              <td class="hint"><%= semesterDays.length ? semesterDays.map(function(d){ return classDayLabels[d]; }).join(', ') : 'No days yet' %></td>
              <td class="hint"><%= fmtDue(s.fees_due_date) || '—' %></td>
              <td class="semester-actions-col">
                <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/archive" class="inline-block-form" data-confirm="Are you sure you want to archive the &quot;<%= s.title %>&quot; semester? All classes, rosters, class chats, and registration will be archived for this semester and will not show up on ANY portals. You can unarchive it at any time." data-confirm-icon="icon-archive" data-confirm-yes-label="Yes, Archive">
                  <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                  <button type="submit" class="icon-btn" aria-label="Archive <%= s.title %>" title="Archive"><svg class="icon"><use href="#icon-archive"/></svg></button>
                </form>
                <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/delete" data-confirm="Are you sure you want to delete the &quot;<%= s.title %>&quot; semester? This action can&#39;t be reversed. Its Floater Assignments, Setup/Cleanup Teams, Task Lists, and Day Settings schedules will be permanently deleted too - classes assigned to it will just show No Semester.">
                  <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= s.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </td>
            </tr>
            <tr id="semester-edit-<%= s.id %>" class="semester-edit-row" hidden>
              <td colspan="4">
                <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/update" class="member-form-grid">
                  <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                  <label class="member-form-full">Title
                    <input type="text" name="title" value="<%= s.title %>" aria-label="Rename <%= s.title %>" required />
                  </label>
                  <label class="member-form-full">Class Fees Due Date
                    <input type="date" name="feesDueDate" value="<%= s.fees_due_date || '' %>" />
                    <span class="hint">Changing it also updates the due date on every unpaid class fee for this semester.</span>
                  </label>
                  <div class="member-form-full">
                    <span class="checkbox-group-label">Days</span>
                    <div class="checkbox-group">
                      <% classDays.forEach(function(d) { %>
                        <label class="checkbox-option">
                          <input type="checkbox" name="days" value="<%= d %>" <%= semesterDays.includes(d) ? 'checked' : '' %> />
                          <%= classDayLabels[d] %>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                  <div class="member-form-full semester-edit-actions">
                    <button type="submit" class="primary-btn">Save</button>
                    <button type="button" class="btn-secondary" data-semester-edit-cancel="semester-edit-<%= s.id %>">Cancel</button>
                  </div>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (archivedSemesters.length) { %>
<section class="portal-dashboard-section archived-semesters">
  <h2><svg class="icon"><use href="#icon-archive"/></svg> Archived Semesters</h2>
  <p class="hint">Hidden from every portal. View one to see its classes, rosters, chats and registrations, or unarchive it to bring everything back.</p>
  <div class="roster-scroll">
    <table class="roster-table members-table condensed-table semester-list-table">
      <thead><tr><th>Title</th><th>Archived</th><th></th></tr></thead>
      <tbody>
        <% archivedSemesters.forEach(function(s) { %>
          <tr>
            <td class="roster-name-col"><%= s.title %> <span class="badge-pill badge-pill-gray">Archived</span></td>
            <td class="hint"><%= s.archivedAtLabel || s.archived_at.slice(0, 10) %></td>
            <td class="semester-actions-col">
              <a class="btn-secondary" href="/admin/schedule/semesters/<%= s.id %>/archive">View</a>
              <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/unarchive" class="inline-block-form" data-confirm="Unarchive the &quot;<%= s.title %>&quot; semester? Its classes, rosters, class chats and registrations will show on every portal again." data-confirm-icon="icon-archive" data-confirm-safe="1" data-confirm-yes-label="Yes, Unarchive">
                <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                <button type="submit" class="btn-secondary" aria-label="Unarchive <%= s.title %>">Unarchive</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
<script src="/js/semester-manager.js"></script>
