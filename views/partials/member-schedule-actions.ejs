<%#
  Export (CSV) / PDF / Print - one row, side by side, on every member
  schedule page/tab/dialog (a real request: "All member schedule pages,
  tabs etc. Should have export, pdf and print icons, in a row side by
  side"). A plain flex row of the usual .icon-btn trio - grouped together
  at the left on every screen size, never stretched across the width.
  Print opens the dedicated preview page in
  a new tab (print-auto.js convention - it waits for the Print button).

  locals: exportHref, pdfHref, printHref
%>
<div class="member-schedule-actions no-print">
  <a class="icon-btn" href="<%= exportHref %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
  <a class="icon-btn" href="<%= pdfHref %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
  <a class="icon-btn" href="<%= printHref %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
</div>
