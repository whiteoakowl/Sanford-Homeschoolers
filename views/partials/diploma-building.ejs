<%# Design 4's engraved-style school building under the arched name
    (drawn here, in grays, inside a soft oval vignette). Locals: uid. %>
<svg class="dip-building" viewBox="0 0 240 100" aria-hidden="true">
  <defs>
    <radialGradient id="dip-bld-fade-<%= uid %>" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#6c6c6c" stop-opacity="0.55" />
      <stop offset="70%" stop-color="#8a8a8a" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#f4ecd6" stop-opacity="0" />
    </radialGradient>
  </defs>
  <ellipse cx="120" cy="52" rx="118" ry="48" fill="url(#dip-bld-fade-<%= uid %>)" />
  <g fill="#3a3a3a">
    <ellipse cx="34" cy="58" rx="22" ry="20" fill="#4a4a4a" />
    <ellipse cx="206" cy="58" rx="22" ry="20" fill="#4a4a4a" />
    <rect x="52" y="40" width="136" height="42" fill="#d9d4c7" />
    <rect x="52" y="38" width="136" height="4" />
    <polygon points="92,38 120,22 148,38" fill="#cfc9bb" stroke="#3a3a3a" stroke-width="1.5" />
    <rect x="114" y="10" width="12" height="13" fill="#cfc9bb" stroke="#3a3a3a" stroke-width="1.2" />
    <rect x="119" y="2" width="1.5" height="9" />
    <path d="M120.8 3 h7 v4 h-7 z" fill="#555" />
    <% for (var i = 0; i < 6; i++) { %><rect x="<%= 96 + i * 9 %>" y="42" width="3.5" height="38" fill="#efeae0" stroke="#555" stroke-width="0.6" /><% } %>
    <% for (var r = 0; r < 2; r++) { for (var c = 0; c < 4; c++) { %>
      <rect x="<%= 57 + c * 9 %>" y="<%= 46 + r * 16 %>" width="5" height="9" fill="#444" />
      <rect x="<%= 152 + c * 9 %>" y="<%= 46 + r * 16 %>" width="5" height="9" fill="#444" />
    <% } } %>
    <rect x="48" y="82" width="144" height="4" />
    <rect x="40" y="86" width="160" height="3" fill="#777" />
  </g>
</svg>
