<%# Lesson Plan content items (video/text/file/quiz/assignment upload/
    assignment submission) - trimmed copy of views/partials/lesson-
    content-manage.ejs (the real class Lesson's own version) for a
    standalone template: no Open/Close Date (nothing to lock yet - no
    class, no students), no per-item Due Date (only makes sense once a
    copy is attached to a real class - see the lesson_plans migration's
    own comment), and no "Review Submissions" link (no submissions can
    exist against a template). plan/contentItems come from the including
    page; lessonPlanBase/showDetailsForm are optional (see below). %>
<%
// lpBase - where this editor's forms post ('/admin/lesson-plans',
// '/teacher/lesson-plans' or '/parent/family-school/lesson-plans', see
// routes/lessonPlanContentRoutes.js). showDetailsForm - the title/
// description/permission checkboxes are admin-only.
var lpBase = typeof lessonPlanBase !== 'undefined' && lessonPlanBase ? lessonPlanBase : '/admin/lesson-plans';
var showDetails = typeof showDetailsForm === 'undefined' || showDetailsForm;
%>
<% if (showDetails) { %>
<div class="manage-section">
  <div class="grid-box-header">
    <h2>Lesson Plan Details</h2>
  </div>
  <form method="POST" action="<%= lpBase %>/<%= plan.id %>/edit" class="member-form-grid">
    <label class="member-form-full">Title
      <input type="text" name="title" value="<%= plan.title %>" required />
    </label>
    <label class="member-form-full">Description
      <textarea name="description" rows="2"><%= plan.description || '' %></textarea>
    </label>
    <%# A real request: "Edit permissions should be check boxes in a
        single column to the left with first word of each sentence
        starting next to it. Add allow members to use this lesson plan
        for Homeschool family management." .checkbox-option already is
        exactly that shape (checkbox left, text starts right next to
        it) - all 3 permissions stack in the same column. A later real
        request ("allow teachers to edit/add to the lesson plan, all
        members to edit/add to the lesson plan") added the other two,
        saved alongside it on this same form/route rather than a
        separate page - both default off, same as Homeschool use. %>
    <%# A later request: the third option reads "in family school
        management", and each question gets space between it. %>
    <div class="member-form-full lesson-plan-permission-list">
      <label class="checkbox-option">
        <input type="checkbox" name="allowFamilySchoolUse" value="1" <%= plan.allow_family_school_use ? 'checked' : '' %> />
        Allow members to use this lesson plan for Homeschool family management
      </label>
      <label class="checkbox-option">
        <input type="checkbox" name="allowTeacherEdit" value="1" <%= plan.allow_teacher_edit ? 'checked' : '' %> />
        Allow teachers to edit/add to the lesson plan
      </label>
      <p class="hint">Teachers edit it only on the co-op class it's assigned to - that class's parents and students see the changes. This plan itself never changes.</p>
      <label class="checkbox-option">
        <input type="checkbox" name="allowMemberEdit" value="1" <%= plan.allow_member_edit ? 'checked' : '' %> />
        Allow parents to edit or add to the lesson plan from the Family School Management portal
      </label>
      <p class="hint">Parents edit their own family's copy - this plan itself never changes.</p>
    </div>
    <div class="member-form-full">
      <button type="submit" class="primary-btn">Save Lesson Plan Details</button>
    </div>
  </form>
</div>
<% } %>

<%# A real request: library plans hold lessons, like the Teacher Portal's
    class Lesson Plan page - "+ Add Lesson" opens a popup, each lesson is a
    bar, and opening a bar shows that lesson's own assignments. %>
<% var openLessonIdLocal = typeof openLessonId !== 'undefined' ? openLessonId : null; %>
<div class="manage-section">
  <div class="grid-box-header">
    <h2>Lessons (<%= lessons.length %>)</h2>
    <button type="button" class="roster-action-btn" onclick="document.getElementById('add-plan-lesson-dialog').showModal()">+ Add Lesson</button>
  </div>
  <% if (lessons.length === 0) { %>
    <p class="roster-empty">No lessons yet. Click Add Lesson to add the first one.</p>
  <% } %>
  <div class="lesson-plan-bars">
    <% lessons.forEach(function(lesson) { %>
      <details class="lesson-plan-bar" id="plan-lesson-<%= lesson.id %>" <%= openLessonIdLocal === lesson.id ? 'open' : '' %>>
        <summary>
          <span class="lesson-plan-bar-title"><%= lesson.title %></span>
          <span class="lesson-plan-bar-meta"><span class="hint"><%= lesson.contentItems.length %> assignment<%= lesson.contentItems.length === 1 ? '' : 's' %></span></span>
        </summary>
        <div class="lesson-plan-bar-body">
          <% if (lesson.description) { %><p class="hint plain-text-display"><%= lesson.description %></p><% } %>
          <div class="roster-btn-row no-print">
            <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-plan-lesson-dialog-<%= lesson.id %>').showModal()">Edit Lesson</button>
            <form method="POST" action="<%= lpBase %>/lessons/<%= lesson.id %>/delete" data-confirm="Delete the lesson &quot;<%= lesson.title %>&quot; and its assignments?">
              <button type="submit" class="roster-action-btn">Delete Lesson</button>
            </form>
          </div>
          <%- include('lesson-plan-lesson-content', { plan, lesson, contentItems: lesson.contentItems, lpBase }) %>
          <dialog id="edit-plan-lesson-dialog-<%= lesson.id %>" class="member-picker-dialog dialog-label-stack">
            <form method="POST" action="<%= lpBase %>/lessons/<%= lesson.id %>/edit" class="member-form-grid">
              <h3>Edit Lesson</h3>
              <label class="member-form-full">Title
                <input type="text" name="title" value="<%= lesson.title %>" required />
              </label>
              <label class="member-form-full">Description
                <textarea name="description" rows="3"><%= lesson.description || '' %></textarea>
              </label>
              <div class="notes-dialog-actions">
                <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                <button type="submit" class="primary-btn">Save</button>
              </div>
            </form>
          </dialog>
        </div>
      </details>
    <% }); %>
  </div>
  <dialog id="add-plan-lesson-dialog" class="member-picker-dialog dialog-label-stack">
    <form method="POST" action="<%= lpBase %>/<%= plan.id %>/lessons" class="member-form-grid">
      <h3>Add Lesson</h3>
      <label class="member-form-full">Title
        <input type="text" name="title" required />
      </label>
      <label class="member-form-full">Description
        <textarea name="description" rows="3"></textarea>
      </label>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="submit" class="primary-btn">Save</button>
      </div>
    </form>
  </dialog>
</div>
<script src="/js/lesson-drag-reorder.js"></script>
<script src="/js/lesson-content-form.js"></script>
<script src="/js/assignment-upload-word-count.js"></script>
<script src="/js/forum-editor.js"></script>
