<%
// A real request: "when you click the edit profile button it should
// look exactly like the membership request form... For the two admin
// portals it will then show an admin only section at the bottom to
// change portals, sections and family." Everything here is an admin-
// only action on an EXISTING member (reassigning their family, which
// Sections they're visible under, which Portal Roles their account
// holds) - deliberately separate from partials/member-edit-fields.ejs
// above it (the part that looks exactly like the public membership
// form) rather than folded into a "Choose a Family" box up top the way
// the public form's own brand-new-member flow uses one, since none of
// this is something either the public form or a self-edit page ever
// touches.
//
// Locals:
//   member, families (with memberCount), memberFamilyId
//   allSections - every defined section, now fed straight into
//     member-portal-roles.ejs's own per-family-member Sections dropdown
//     below (a real request: "each family member should be listed with
//     a dropdown menu for portals and dropdown menu for sections under
//     each member name" - Sections used to be its own single-member
//     checklist-dropdown control right here; that's gone, replaced by
//     the per-row Sections dropdown member-portal-roles.ejs now renders
//     next to Portals for every family member).
//   allRoles, portalRoleIds (Set) - only rendered when portalAccount is
//     truthy, same "nothing to grant without an account" reasoning the
//     box this replaced already used
//   portalAccount - null or the account row
//   hasPasswordField - whether the member-edit-fields.ejs box above this
//     one (same page) actually offers a Password field - Main Admin's
//     own edit page does (creating a portal account is Main-Admin-only),
//     Co-op Admin's doesn't, so the "no account yet" hint below points
//     there instead of at a field that isn't on the page.
%>
<div class="manage-section member-form-section-box member-form-section-purple" data-family-box>
  <h2><svg class="icon"><use href="#icon-sliders"/></svg> Admin Settings</h2>

  <label class="member-form-full"><strong>Family</strong>
    <select name="familyId" data-family-select>
      <option value="">Choose from available families</option>
      <% families.forEach(function(f) { %>
        <option value="<%= f.id %>" <%= memberFamilyId === f.id ? 'selected' : '' %>>The <%= f.name %> Family</option>
      <% }); %>
    </select>
  </label>
  <button type="button" class="btn-secondary member-form-add-family-btn" data-add-family-open>+ Add New Family</button>

  <%
  // A real request: "When the box is checked on child for allow student
  // portal. That is all they have access too, the student portal. When
  // editing the paren member, and choosing portals it will list each
  // member in that family with a portal dropdown next to it" - and a
  // later one: "each family member should be listed with a dropdown
  // menu for portals and dropdown menu for sections under each member
  // name" - both now live in views/partials/member-portal-roles.ejs,
  // which renders one row per family member, each with its own Portals
  // control (single Allow Student Portal checkbox for a student, a
  // multi-select dropdown for anyone else) and its own Sections
  // multi-select dropdown right next to it. familyPortalRows comes from
  // the routes' own GET /:id/edit (member + familyOf(id), each with its
  // own portal account/role/section state) - falls back to just this
  // member's own row if a caller hasn't been updated to pass it, so this
  // partial never crashes on a missing local.
  var portalRolesRows = typeof familyPortalRows !== 'undefined' && familyPortalRows
    ? familyPortalRows
    : [{ member, portalAccount, roleIds: portalRoleIds, sectionIds: (typeof memberSectionIds !== 'undefined' ? memberSectionIds : new Set()) }];
  %>
  <%- include('member-portal-roles', { member, allRoles, allSections, familyPortalRows: portalRolesRows }) %>
</div>
