      <line x1="510" y1="710" x2="735" y2="710" stroke="<%= T.line %>" stroke-width="2.5" />
      <text x="365" y="757" font-size="22">Parent/Teacher:</text>
      <line x1="510" y1="760" x2="735" y2="760" stroke="<%= T.line %>" stroke-width="2.5" />
    </g>
    <g font-family="'Caveat', 'Segoe Print', cursive" font-weight="700" fill="#1b2a55">
      <% if (A.studentName) { %><text x="550" y="643" font-size="46" text-anchor="middle" textLength="<%= Math.min(350, A.studentName.length * 22) %>" lengthAdjust="spacingAndGlyphs"><%= A.studentName %></text><% } %>
      <% if (A.parent1) { %><text x="622" y="703" font-size="34" text-anchor="middle" textLength="<%= Math.min(220, A.parent1.length * 15) %>" lengthAdjust="spacingAndGlyphs"><%= A.parent1 %></text><% } %>
      <% if (A.parent2) { %><text x="622" y="753" font-size="34" text-anchor="middle" textLength="<%= Math.min(220, A.parent2.length * 15) %>" lengthAdjust="spacingAndGlyphs"><%= A.parent2 %></text><% } %>
    </g>
  </g>
</svg>
