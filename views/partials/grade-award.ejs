      <path d="M 30 30 L 220 30 L 250 60 M 1070 30 L 880 30 L 850 60 M 30 820 L 220 820 L 250 790 M 1070 820 L 880 820 L 850 790" stroke="#3fd7ff" stroke-width="6" />
