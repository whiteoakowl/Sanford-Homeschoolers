    <polygon points="520,250 720,20 920,250" fill="#5f7590" /><polygon points="720,20 668,80 700,88 722,62 748,92 774,82" fill="#fff" />
    <polygon points="100,260 300,110 500,260" fill="#94a7ba" /><polygon points="300,110 262,140 290,146 305,130 325,148" fill="#fff" />
    <polygon points="760,260 930,120 1100,260" fill="#8fa2b6" /><polygon points="930,120 896,148 920,152 934,138 952,154" fill="#fff" />
    <path d="M 0 250 Q 300 200 550 245 Q 820 290 1100 240 L 1100 330 L 0 330 Z" fill="#6ab04c" />
    <% [[40,330,210],[110,330,170],[180,330,140],[1060,330,210],[990,330,170],[920,330,140],[55,850,300],[140,850,240],[1045,850,300],[960,850,240],[30,640,200],[1070,640,200]].forEach(function(p, i) { %><%- pine(p[0], p[1], p[2], i % 2 ? '#2e7d32' : '#1b5e20') %><% }); %>
    <path d="M 0 850 Q 550 780 1100 850 Z" fill="#6ab04c" />
  <% } else if (A.design === 'neon') { %>
