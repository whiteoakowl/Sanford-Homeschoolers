    <g transform="translate(150 150)"><circle r="95" fill="#ef7d22" stroke="#222" stroke-width="5" /><path d="M -95 0 H 95 M 0 -95 V 95 M -67 -67 Q 0 0 -67 67 M 67 -67 Q 0 0 67 67" stroke="#222" stroke-width="5" fill="none" /></g>
    <g transform="translate(965 140)"><circle r="85" fill="#fff" stroke="#222" stroke-width="5" /><polygon points="0,-28 27,-9 17,23 -17,23 -27,-9" fill="#222" /><% [[0,-70],[62,-25],[40,58],[-40,58],[-62,-25]].forEach(function(p){ %><polygon points="<%= p[0] %>,<%= p[1] - 15 %> <%= p[0] + 15 %>,<%= p[1] - 4 %> <%= p[0] + 9 %>,<%= p[1] + 13 %> <%= p[0] - 9 %>,<%= p[1] + 13 %> <%= p[0] - 15 %>,<%= p[1] - 4 %>" fill="#222" /><% }); %></g>
    <% [[95,620,-35],[1010,620,35]].forEach(function(f) { %><g transform="translate(<%= f[0] %> <%= f[1] %>) rotate(<%= f[2] %>)"><ellipse rx="95" ry="56" fill="#8b3a1a" stroke="#4a1e0c" stroke-width="5" /><path d="M -50 0 H 50" stroke="#fff" stroke-width="6" /><% for (var k = -3; k <= 3; k++) { %><path d="M <%= k * 13 %> -10 V 10" stroke="#fff" stroke-width="5" /><% } %><path d="M -80 -22 Q -88 0 -80 22 M 80 -22 Q 88 0 80 22" stroke="#fff" stroke-width="5" fill="none" /></g><% }); %>
    <path d="M 300 160 C 380 80, 470 200, 560 120" stroke="#0f1d40" stroke-width="4" stroke-dasharray="10 10" fill="none" />
    <%- star(460, 70, 22, '#ffffff', 0, ' stroke="#0f1d40" stroke-width="3"') %><%- star(640, 60, 18, '#0f1d40') %><%- star(860, 70, 20, '#ffffff', 0, ' stroke="#0f1d40" stroke-width="3"') %><%- star(140, 400, 18, 'none', 0, ' stroke="#0f1d40" stroke-width="3"') %><%- star(980, 400, 18, '#0f1d40') %><%- star(60, 820, 20, '#ffffff') %><%- star(1040, 820, 20, '#ffffff') %>
  <% } else if (A.design === 'butterfly') { %>
    <rect width="1100" height="850" fill="#fbf7ff" />
    <g filter="url(#ga-soft-<%= U %>)" opacity="0.5"><ellipse cx="550" cy="40" rx="560" ry="90" fill="#cfe6ff" /><ellipse cx="550" cy="860" rx="600" ry="90" fill="#cdeec0" /></g>
    <% function bfly(x, y, s, c1, c2, rot) { %><g transform="translate(<%= x %> <%= y %>) rotate(<%= rot %>) scale(<%= s %>)"><path d="M 0 0 C -60 -80, -130 -40, -100 10 C -80 40, -30 30, 0 0 Z" fill="<%= c1 %>" stroke="#3a2a4a" stroke-width="3" /><path d="M 0 0 C 60 -80, 130 -40, 100 10 C 80 40, 30 30, 0 0 Z" fill="<%= c1 %>" stroke="#3a2a4a" stroke-width="3" /><path d="M 0 5 C -50 20, -70 70, -30 75 C -10 75, 0 40, 0 5 Z" fill="<%= c2 %>" stroke="#3a2a4a" stroke-width="3" /><path d="M 0 5 C 50 20, 70 70, 30 75 C 10 75, 0 40, 0 5 Z" fill="<%= c2 %>" stroke="#3a2a4a" stroke-width="3" /><circle cx="-60" cy="-20" r="10" fill="#fff" opacity="0.7" /><circle cx="60" cy="-20" r="10" fill="#fff" opacity="0.7" /><ellipse cx="0" cy="20" rx="6" ry="40" fill="#3a2a4a" /><path d="M -3 -18 Q -15 -50 -25 -55 M 3 -18 Q 15 -50 25 -55" stroke="#3a2a4a" stroke-width="3" fill="none" /></g><% } %>
    <% bfly(150, 130, 1.1, '#f6a623', '#f7d046', -12); bfly(950, 130, 1.1, '#e05bb5', '#9b59d0', 15); bfly(420, 80, 0.45, '#7ac7f0', '#a0e0ff', -10); bfly(700, 90, 0.45, '#9bd36a', '#c8f09a', 10); bfly(90, 440, 0.55, '#7ac7f0', '#c5a3f0', -20); bfly(1010, 450, 0.6, '#e05bb5', '#f7a5d6', 20); %>
    <% [[60,780,'#f48fb1'],[150,700,'#ce93d8'],[90,620,'#f7d046'],[230,800,'#81d4fa'],[1040,780,'#f48fb1'],[950,700,'#f7d046'],[1010,610,'#ce93d8'],[870,800,'#81d4fa'],[320,830,'#f48fb1'],[780,830,'#ce93d8']].forEach(function(f, i) { %><path d="M <%= f[0] %> 850 Q <%= f[0] + 10 %> <%= f[1] + 60 %> <%= f[0] %> <%= f[1] %>" stroke="#5aa23a" stroke-width="5" fill="none" /><%- leaf(f[0] + 18, f[1] + 60, 22, -30, '#6abf45') %><%- flower(f[0], f[1], 40 - (i % 3) * 6, f[2]) %><% }); %>
    <%- sparkle(300, 200, 16, '#f7c6e8') %><%- sparkle(800, 220, 14, '#c5a3f0') %><%- sparkle(250, 520, 12, '#f7d046') %>
  <% } else if (A.design === 'mountains') { %>
    <rect width="1100" height="850" fill="#f4faf2" />
    <rect width="1100" height="260" fill="#d8ecfa" />
