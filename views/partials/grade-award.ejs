    <ellipse cx="550" cy="425" rx="505" ry="392" fill="none" stroke="#d4a017" stroke-width="2.5" />
    <path d="M 40 300 Q 160 120 380 60 M 1060 300 Q 940 120 720 60 M 40 560 Q 160 740 380 800 M 1060 560 Q 940 740 720 800" stroke="url(#ga-g2-<%= U %>)" stroke-width="5" fill="none" />
    <% for (var i = 0; i < 26; i++) { %><%- sparkle((60 + rnd() * 980).toFixed(0), (30 + rnd() * 790).toFixed(0), (5 + rnd() * 12).toFixed(0), '#f2c14e') %><% } %>
    <%- gradCap(550, 100, 115, '#1a1a1a', '#e8bb4a') %>
    <g transform="translate(905 690) rotate(-28)"><rect x="-95" y="-24" width="190" height="48" rx="22" fill="#f6ecd6" stroke="#c9a24a" stroke-width="4" /><ellipse cx="-95" cy="0" rx="14" ry="24" fill="#e9dcbc" stroke="#c9a24a" stroke-width="4" /><rect x="-12" y="-26" width="24" height="52" fill="#c0392b" /><path d="M 0 26 L -18 62 M 0 26 L 18 62" stroke="#c0392b" stroke-width="8" /></g>
  <% } %>

  <%# The words and the name panel - same place on every design. %>
  <g font-family="'Kaushan Script', 'Brush Script MT', cursive" text-anchor="middle"<% if (T.glow) { %> filter="url(#ga-glow-<%= U %>)"<% } %>>
    <text font-size="118" fill="<%= T.c %>" stroke="<%= cs %>" stroke-width="12" stroke-linejoin="round" paint-order="stroke" filter="url(#ga-shadow-<%= U %>)"><textPath href="#ga-arc-<%= U %>" startOffset="50%">Congratulations</textPath></text>
  </g>
  <g font-family="'Oswald', 'Arial Narrow', sans-serif" font-weight="600" text-anchor="middle"<% if (T.glow) { %> filter="url(#ga-glow-<%= U %>)"<% } %>>
