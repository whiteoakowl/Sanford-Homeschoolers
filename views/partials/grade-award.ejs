<%
// A real request: grade level awards in 15 designs (Preschool through
// 12th Grade), each "Congratulations / You finished / {grade}!" over its
// own artwork, with a Student Name line and two Parent/Teacher lines -
// landscape, full page. Drawn as one vector picture (1100 x 850, the
// shape of a landscape letter page) so it prints sharp at any size.
// Locals: award (utils/gradeAwards.js awardFromQuery), optional uid.
var A = award;
var U = (locals.uid || 'ga') + '-' + A.design;
function esc(t) { return String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function star(cx, cy, r, fill, rot, extra) {
  var pts = [];
  for (var i = 0; i < 10; i++) {
    var ang = ((rot || 0) - 90 + i * 36) * Math.PI / 180;
    var rr = i % 2 ? r * 0.45 : r;
    pts.push((cx + Math.cos(ang) * rr).toFixed(1) + ',' + (cy + Math.sin(ang) * rr).toFixed(1));
  }
  return '<polygon points="' + pts.join(' ') + '" fill="' + fill + '"' + (extra || '') + ' />';
}
function sparkle(cx, cy, r, fill) {
  cx = Number(cx); cy = Number(cy); r = Number(r);
  return '<path d="M' + cx + ' ' + (cy - r) + ' Q' + cx + ' ' + cy + ' ' + (cx + r) + ' ' + cy + ' Q' + cx + ' ' + cy + ' ' + cx + ' ' + (cy + r) + ' Q' + cx + ' ' + cy + ' ' + (cx - r) + ' ' + cy + ' Q' + cx + ' ' + cy + ' ' + cx + ' ' + (cy - r) + ' Z" fill="' + fill + '" />';
}
function daisy(cx, cy, r) {
  var s = '';
  for (var i = 0; i < 12; i++) s += '<ellipse cx="' + cx + '" cy="' + (cy - r * 0.55) + '" rx="' + (r * 0.2) + '" ry="' + (r * 0.5) + '" fill="#fff" stroke="#e4e0c8" stroke-width="1" transform="rotate(' + (i * 30) + ' ' + cx + ' ' + cy + ')" />';
  return s + '<circle cx="' + cx + '" cy="' + cy + '" r="' + (r * 0.28) + '" fill="#f6c21c" />';
}
function flower(cx, cy, r, color, center) {
  var s = '';
  for (var i = 0; i < 5; i++) s += '<circle cx="' + (cx + Math.cos(i * 1.2566) * r * 0.55).toFixed(1) + '" cy="' + (cy + Math.sin(i * 1.2566) * r * 0.55).toFixed(1) + '" r="' + (r * 0.45) + '" fill="' + color + '" />';
  return s + '<circle cx="' + cx + '" cy="' + cy + '" r="' + (r * 0.3) + '" fill="' + (center || '#ffd34d') + '" />';
}
function leaf(x, y, len, ang, color) {
  return '<ellipse cx="' + x + '" cy="' + y + '" rx="' + len + '" ry="' + (len * 0.38) + '" fill="' + color + '" transform="rotate(' + ang + ' ' + x + ' ' + y + ')" />';
}
function vine(d, color, leaves) {
  var s = '<path d="' + d + '" fill="none" stroke="' + color + '" stroke-width="6" stroke-linecap="round" />';
  (leaves || []).forEach(function (l) { s += leaf(l[0], l[1], l[2], l[3], l[4] || color); });
  return s;
}
function pine(x, base, h, color) {
  var w = h * 0.42, s = '<rect x="' + (x - h * 0.04) + '" y="' + (base - h * 0.12) + '" width="' + (h * 0.08) + '" height="' + (h * 0.12) + '" fill="#6b4423" />';
  for (var i = 0; i < 4; i++) {
    var top = base - h + i * h * 0.2, bot = base - h * 0.1 - (3 - i) * h * 0.12;
    var ww = w * (0.45 + i * 0.2);
    s += '<polygon points="' + x + ',' + top + ' ' + (x - ww) + ',' + bot + ' ' + (x + ww) + ',' + bot + '" fill="' + color + '" />';
  }
  return s;
}
function hand(x, y, sz, color, rot) {
  var s = '<g transform="rotate(' + rot + ' ' + x + ' ' + y + ')" fill="' + color + '" opacity="0.85">';
  s += '<ellipse cx="' + x + '" cy="' + y + '" rx="' + (sz * 0.4) + '" ry="' + (sz * 0.44) + '" />';
  [[-0.3, -0.62, 0.11, 0.28], [-0.1, -0.74, 0.1, 0.3], [0.12, -0.74, 0.1, 0.3], [0.32, -0.62, 0.1, 0.26], [-0.48, -0.08, 0.1, 0.26]].forEach(function (f, i) {
    s += '<ellipse cx="' + (x + f[0] * sz) + '" cy="' + (y + f[1] * sz) + '" rx="' + (f[2] * sz) + '" ry="' + (f[3] * sz) + '"' + (i === 4 ? ' transform="rotate(-40 ' + (x + f[0] * sz) + ' ' + (y + f[1] * sz) + ')"' : '') + ' />';
  });
  return s + '</g>';
}
function crayon(x, base, h, color) {
  return '<g><rect x="' + x + '" y="' + (base - h) + '" width="26" height="' + h + '" rx="3" fill="' + color + '" />'
    + '<polygon points="' + x + ',' + (base - h) + ' ' + (x + 13) + ',' + (base - h - 30) + ' ' + (x + 26) + ',' + (base - h) + '" fill="' + color + '" />'
    + '<rect x="' + x + '" y="' + (base - h + 18) + '" width="26" height="8" fill="#000" opacity="0.18" /><rect x="' + x + '" y="' + (base - 28) + '" width="26" height="8" fill="#000" opacity="0.18" /></g>';
}
var seed = 7;
function rnd() { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }
function splat(cx, cy, r, color) {
  var s = '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="' + color + '" opacity="0.85" />';
  for (var i = 0; i < 9; i++) {
    var ang = rnd() * Math.PI * 2, dist = r * (1 + rnd() * 0.9), rr = r * (0.08 + rnd() * 0.22);
    s += '<circle cx="' + (cx + Math.cos(ang) * dist).toFixed(1) + '" cy="' + (cy + Math.sin(ang) * dist).toFixed(1) + '" r="' + rr.toFixed(1) + '" fill="' + color + '" opacity="0.85" />';
  }
  return s;
}
function gradCap(cx, cy, s, cap, tassel) {
  return '<g><path d="M' + (cx - s * 0.55) + ' ' + (cy + s * 0.05) + ' L' + (cx - s * 0.55) + ' ' + (cy + s * 0.38) + ' Q' + cx + ' ' + (cy + s * 0.6) + ' ' + (cx + s * 0.55) + ' ' + (cy + s * 0.38) + ' L' + (cx + s * 0.55) + ' ' + (cy + s * 0.05) + ' Z" fill="' + cap + '" />'
    + '<polygon points="' + cx + ',' + (cy - s * 0.42) + ' ' + (cx + s * 1.1) + ',' + cy + ' ' + cx + ',' + (cy + s * 0.42) + ' ' + (cx - s * 1.1) + ',' + cy + '" fill="' + cap + '" stroke="#ffffff" stroke-opacity="0.25" stroke-width="3" />'
    + '<path d="M' + cx + ' ' + cy + ' L' + (cx - s * 0.85) + ' ' + (cy + s * 0.12) + ' L' + (cx - s * 0.85) + ' ' + (cy + s * 0.75) + '" fill="none" stroke="' + tassel + '" stroke-width="' + (s * 0.06) + '" />'
    + '<rect x="' + (cx - s * 0.92) + '" y="' + (cy + s * 0.7) + '" width="' + (s * 0.14) + '" height="' + (s * 0.32) + '" rx="' + (s * 0.04) + '" fill="' + tassel + '" />'
    + '<circle cx="' + cx + '" cy="' + cy + '" r="' + (s * 0.07) + '" fill="' + tassel + '" /></g>';
}

// Each design's own text colors and Student Name panel.
var T = {
  rainbow:   { c: '#1d3577', f: '#8a2bc2', g: '#7b23b8', panel: '#ffffff', po: 0.85, line: '#555' },
  bee:       { c: '#1f1f1f', f: '#2f8a2c', g: '#2b7d27', panel: '#ffffff', po: 0.85, line: '#555' },
  apple:     { c: '#1c1c1c', f: '#d42a1f', g: '#cf1f14', panel: '#ffffff', po: 0.85, line: '#555' },
  rocket:    { c: '#ffffff', cs: '#0d1f4f', f: '#ffffff', g: '#ffd23f', panel: '#eef4ff', po: 0.97, line: '#33415f', label: '#1b2a55' },
  dinosaur:  { c: '#1e3a1c', f: '#2d7a2a', g: '#1f5c1d', panel: '#ffffff', po: 0.88, line: '#555' },
  turtle:    { c: '#0f3561', f: '#0f3d73', g: '#1a5aa0', panel: '#ffffff', po: 0.88, line: '#555' },
  sports:    { c: '#141414', f: '#e07514', g: '#e06d0c', panel: '#ffffff', po: 1, line: '#555' },
  butterfly: { c: '#4b1f7a', f: '#8a2db8', g: '#7a1fae', panel: '#ffffff', po: 0.88, line: '#555' },
  mountains: { c: '#1d3a1a', f: '#2f7d2a', g: '#1d5f1a', panel: '#ffffff', po: 0.9, line: '#555' },
  neon:      { c: '#ffffff', cs: '#3a1d8a', f: '#3fd7ff', g: '#3fd7ff', panel: '#dcecff', po: 0.95, line: '#2b3d66', label: '#1b2a55', glow: true },
  paint:     { c: '#3d1a6e', f: '#4a2486', g: '#3d1a78', panel: '#ffffff', po: 0.9, line: '#555' },
  city:      { c: '#1b1f3a', f: '#1b1f3a', g: '#141833', panel: '#ffffff', po: 0.92, line: '#555' },
  goldstars: { c: '#2a2217', f: '#c88a14', g: '#c2810c', panel: '#ffffff', po: 0.92, line: '#6b5a3a' },
  laurel:    { c: '#13306b', f: '#13306b', g: '#13306b', panel: '#ffffff', po: 0.95, line: '#33415f', label: '#13306b' },
  blackgold: { c: '#e8bb4a', cs: '#2a2008', f: '#e8bb4a', g: '#e8bb4a', panel: '#f6ecd6', po: 1, line: '#4a3a18', label: '#2a2008' },
}[A.design];
var cs = T.cs || '#ffffff';
%>
<svg class="grade-award grade-award-<%= A.design %>" viewBox="0 0 1100 850" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Congratulations! You finished <%= A.gradeLabel %>">
  <defs>
    <filter id="ga-shadow-<%= U %>" x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#000" flood-opacity="0.25" /></filter>
    <filter id="ga-glow-<%= U %>" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    <filter id="ga-soft-<%= U %>"><feGaussianBlur stdDeviation="14" /></filter>
    <path id="ga-arc-<%= U %>" d="M 110 345 Q 550 225 990 345" />
  </defs>

  <% if (A.design === 'rainbow') { %>
    <rect width="1100" height="850" fill="#fffdf7" />
    <g filter="url(#ga-soft-<%= U %>)" opacity="0.55"><ellipse cx="160" cy="790" rx="260" ry="90" fill="#7cc7ef" /><ellipse cx="980" cy="800" rx="230" ry="80" fill="#8fd0f2" /><ellipse cx="550" cy="840" rx="300" ry="60" fill="#b6e2f7" /></g>
    <% ['#e9402f', '#f5892a', '#f7d038', '#5cba47', '#2f8de4', '#7d4ccf'].forEach(function(c, i) { %>
      <path d="M <%= -40 + i * 24 %> 330 A <%= 330 - i * 24 %> <%= 300 - i * 24 %> 0 0 1 <%= 620 - i * 24 %> 330" fill="none" stroke="<%= c %>" stroke-width="26" opacity="0.9" />
    <% }); %>
    <ellipse cx="150" cy="325" rx="120" ry="40" fill="#fff" /><ellipse cx="560" cy="330" rx="110" ry="38" fill="#fff" />
    <g><% for (var i = 0; i < 12; i++) { %><line x1="930" y1="140" x2="<%= (930 + Math.cos(i * 0.5236) * 120).toFixed(1) %>" y2="<%= (140 + Math.sin(i * 0.5236) * 120).toFixed(1) %>" stroke="#f9c22e" stroke-width="10" stroke-linecap="round" /><% } %>
      <circle cx="930" cy="140" r="80" fill="#fdd835" /><circle cx="905" cy="128" r="8" fill="#5a3a0a" /><circle cx="955" cy="128" r="8" fill="#5a3a0a" /><path d="M 895 160 Q 930 192 965 160" fill="none" stroke="#5a3a0a" stroke-width="7" stroke-linecap="round" /><circle cx="887" cy="155" r="10" fill="#f7a35c" opacity="0.6" /><circle cx="973" cy="155" r="10" fill="#f7a35c" opacity="0.6" /></g>
    <%- hand(110, 520, 120, '#ee4d8b', -18) %><%- hand(115, 700, 120, '#2f8de4', 12) %><%- hand(990, 520, 120, '#f7c62a', 15) %><%- hand(985, 700, 110, '#58b947', -10) %>
    <%- star(60, 60, 28, '#5cba47') %><%- star(760, 70, 22, '#f5892a') %><%- star(1040, 330, 30, '#7d4ccf') %><%- star(70, 420, 20, '#f7d038') %><%- star(820, 400, 22, '#2f8de4') %><%- star(260, 440, 16, '#ee4d8b') %>
  <% } else if (A.design === 'bee') { %>
    <rect width="1100" height="850" fill="#fffbea" />
    <g fill="#ffd54a" stroke="#f3b51e" stroke-width="5" opacity="0.9"><% [[40,40],[112,40],[184,40],[76,102],[148,102],[40,164],[112,164],[256,40],[220,102]].forEach(function(h){ %><polygon points="<%= [0,1,2,3,4,5].map(function(k){ return (h[0] + Math.cos(k*1.0472)*40).toFixed(1) + ',' + (h[1] + Math.sin(k*1.0472)*40).toFixed(1); }).join(' ') %>" /><% }); %></g>
    <path d="M 420 170 C 520 60, 640 210, 760 110 S 880 60, 900 120" fill="none" stroke="#333" stroke-width="4" stroke-dasharray="12 12" />
    <g transform="translate(965 130)"><ellipse cx="-30" cy="-50" rx="38" ry="26" fill="#e8f4ff" stroke="#8bb7d9" stroke-width="3" transform="rotate(-25 -30 -50)" /><ellipse cx="25" cy="-55" rx="38" ry="26" fill="#e8f4ff" stroke="#8bb7d9" stroke-width="3" transform="rotate(20 25 -55)" /><ellipse cx="0" cy="0" rx="72" ry="55" fill="#ffcf2b" stroke="#222" stroke-width="5" /><path d="M -25 -50 Q -32 0 -25 50 M 8 -54 Q 1 0 8 54 M 40 -40 Q 34 0 40 40" stroke="#222" stroke-width="15" fill="none" /><circle cx="-48" cy="-8" r="34" fill="#ffcf2b" stroke="#222" stroke-width="5" /><circle cx="-58" cy="-14" r="6" fill="#222" /><circle cx="-38" cy="-14" r="6" fill="#222" /><path d="M -62 4 Q -48 16 -34 4" fill="none" stroke="#222" stroke-width="4" stroke-linecap="round" /><path d="M -60 -38 Q -70 -70 -80 -72 M -40 -40 Q -36 -72 -26 -76" stroke="#222" stroke-width="4" fill="none" /><circle cx="-80" cy="-72" r="5" fill="#222" /><circle cx="-26" cy="-76" r="5" fill="#222" /></g>
    <%- vine('M 20 850 Q 70 650 40 460', '#5aa23a', [[52,700,34,-60],[30,610,30,-120],[60,520,28,-50]]) %><%- vine('M 1080 850 Q 1030 640 1065 450', '#5aa23a', [[1048,700,34,-120],[1070,600,30,-60],[1045,520,28,-130]]) %>
    <%- daisy(95, 760, 70) %><%- daisy(175, 640, 52) %><%- daisy(1005, 760, 70) %><%- daisy(925, 650, 50) %><%- daisy(70, 560, 40) %><%- daisy(1035, 560, 42) %>
    <%- star(340, 70, 16, '#f3b51e') %><%- star(650, 60, 14, '#f3b51e') %><%- star(820, 260, 14, '#f3b51e') %>
  <% } else if (A.design === 'apple') { %>
    <rect width="1100" height="850" fill="#fffef8" />
    <%- vine('M 0 40 Q 150 30 230 120 Q 280 190 260 300', '#4f9a35', [[80,48,32,10],[170,70,30,40],[245,170,30,70],[262,250,28,95],[30,120,34,-60]]) %>
    <%- vine('M 1100 40 Q 950 30 870 120 Q 820 190 840 300', '#4f9a35', [[1020,48,32,-10],[930,70,30,-40],[855,170,30,-70],[838,250,28,-95],[1070,120,34,60]]) %>
    <%- vine('M 40 0 L 40 520', '#5aa23a', [[60,200,26,-40],[22,320,26,-140],[60,430,24,-40]]) %><%- vine('M 1060 0 L 1060 520', '#5aa23a', [[1040,200,26,-140],[1078,320,26,-40],[1040,430,24,-140]]) %>
    <g><path d="M 550 60 C 495 38, 450 90, 470 150 C 485 200, 525 210, 550 196 C 575 210, 615 200, 630 150 C 650 90, 605 38, 550 60 Z" fill="#e0261b" /><path d="M 515 85 Q 500 110 505 135" stroke="#fff" stroke-width="9" stroke-linecap="round" opacity="0.55" fill="none" /><path d="M 550 62 Q 552 38 562 22" stroke="#6b4423" stroke-width="8" stroke-linecap="round" fill="none" /><%- leaf(585, 38, 26, -25, '#4f9a35') %></g>
    <% ['#e53935','#fb8c00','#fdd835','#43a047','#1e88e5','#5e35b1','#ec407a','#8d6e63','#00acc1','#e53935','#fb8c00','#fdd835','#43a047','#1e88e5','#5e35b1','#ec407a'].forEach(function(c, i) { var x = i < 8 ? 30 + i * 32 : 820 + (i - 8) * 32; %><%- crayon(x, 850, 150 + ((i * 37) % 60), c) %><% }); %>
    <rect x="0" y="830" width="1100" height="20" fill="#7dc35b" />
  <% } else if (A.design === 'rocket') { %>
    <rect width="1100" height="850" fill="#0d1f4f" />
    <g filter="url(#ga-soft-<%= U %>)" opacity="0.5"><ellipse cx="300" cy="250" rx="260" ry="140" fill="#2a3f8f" /><ellipse cx="850" cy="300" rx="260" ry="160" fill="#26357a" /></g>
    <% for (var i = 0; i < 70; i++) { %><circle cx="<%= (rnd() * 1100).toFixed(0) %>" cy="<%= (rnd() * 600).toFixed(0) %>" r="<%= (1 + rnd() * 2.2).toFixed(1) %>" fill="#fff" opacity="<%= (0.5 + rnd() * 0.5).toFixed(2) %>" /><% } %>
    <g transform="rotate(38 200 150)"><path d="M 200 40 C 240 80, 250 170, 240 230 L 160 230 C 150 170, 160 80, 200 40 Z" fill="#f2f4f8" stroke="#c3c9d6" stroke-width="3" /><path d="M 200 40 C 225 60, 236 90, 238 110 L 162 110 C 164 90, 175 60, 200 40 Z" fill="#e53935" /><circle cx="200" cy="155" r="24" fill="#3b82f6" stroke="#9aa3b5" stroke-width="7" /><path d="M 160 190 L 120 255 L 165 235 Z M 240 190 L 280 255 L 235 235 Z" fill="#e53935" /><path d="M 170 232 Q 200 330 230 232 Z" fill="#ffb300" /><path d="M 182 232 Q 200 290 218 232 Z" fill="#fff176" /></g>
    <%- star(560, 70, 30, '#ffd23f') %><%- star(860, 60, 36, '#ffd23f') %><%- star(990, 160, 22, '#ffd23f') %><%- star(740, 170, 18, '#ffd23f') %><%- star(110, 430, 22, '#ffd23f') %><%- star(990, 430, 26, '#ffd23f') %><%- star(380, 110, 14, '#ffd23f') %>
    <g fill="#ffffff"><ellipse cx="120" cy="820" rx="220" ry="110" /><ellipse cx="330" cy="860" rx="200" ry="110" /><ellipse cx="560" cy="870" rx="230" ry="100" /><ellipse cx="800" cy="850" rx="220" ry="110" /><ellipse cx="1010" cy="820" rx="200" ry="120" /><ellipse cx="40" cy="700" rx="110" ry="70" /><ellipse cx="1070" cy="690" rx="110" ry="70" /></g>
  <% } else if (A.design === 'dinosaur') { %>
    <rect width="1100" height="850" fill="#f6f9ee" />
    <g><polygon points="60,330 190,110 230,110 360,330" fill="#8a5a3c" /><polygon points="190,110 230,110 250,150 170,150" fill="#ef6c2f" /><path d="M 200 110 C 180 60, 230 50, 215 10 M 215 110 C 250 70, 280 80, 270 30" stroke="#b0b0b0" stroke-width="18" fill="none" opacity="0.6" stroke-linecap="round" /><path d="M 195 150 L 160 260 M 225 150 L 250 240" stroke="#ef6c2f" stroke-width="10" /></g>
    <% [[0,0,-30],[1100,0,210],[0,850,30],[1100,850,150]].forEach(function(c) { for (var k = 0; k < 6; k++) { %><%- leaf(c[0] + Math.cos((c[2] + k * 15) * Math.PI / 180) * 140, c[1] + Math.sin((c[2] + k * 15) * Math.PI / 180) * 140, 120, c[2] + k * 15, k % 2 ? '#2e7d32' : '#43a047') %><% } }); %>
    <g transform="translate(905 150)"><path d="M -80 160 C -120 120, -140 40, -60 20 C -20 10, 20 20, 40 60 L 40 160 Z" fill="#5cb85c" /><path d="M -10 20 C -40 -60, 60 -110, 120 -70 C 160 -40, 150 10, 110 20 C 80 30, 50 30, 20 40 Z" fill="#5cb85c" stroke="#2e7d32" stroke-width="4" /><circle cx="70" cy="-55" r="14" fill="#fff" /><circle cx="74" cy="-55" r="7" fill="#222" /><path d="M 40 5 L 145 0" stroke="#fff" stroke-width="10" /><path d="M 52 4 l 6 12 l 6 -12 l 6 12 l 6 -12 l 6 12 l 6 -12 l 6 12 l 6 -12 l 6 12" fill="#fff" stroke="#2e7d32" stroke-width="2" /><path d="M 20 80 q -30 10 -40 40" stroke="#2e7d32" stroke-width="10" fill="none" stroke-linecap="round" /><% for (var k = 0; k < 6; k++) { %><polygon points="<%= -70 + k * 22 %>,<%= 25 - k * 6 %> <%= -60 + k * 22 %>,<%= -5 - k * 6 %> <%= -50 + k * 22 %>,<%= 25 - k * 6 %>" fill="#2e7d32" /><% } %></g>
    <rect x="60" y="560" width="26" height="290" fill="#7b5032" /><%- leaf(73, 560, 90, -150, '#2e7d32') %><%- leaf(73, 560, 90, -30, '#43a047') %><%- leaf(73, 560, 80, -90, '#388e3c') %>
    <rect x="1010" y="580" width="26" height="270" fill="#7b5032" /><%- leaf(1023, 580, 90, -150, '#43a047') %><%- leaf(1023, 580, 90, -30, '#2e7d32') %><%- leaf(1023, 580, 80, -90, '#388e3c') %>
  <% } else if (A.design === 'turtle') { %>
    <rect width="1100" height="850" fill="#eaf7fd" />
    <g filter="url(#ga-soft-<%= U %>)" opacity="0.7"><ellipse cx="90" cy="220" rx="170" ry="240" fill="#8fd3f3" /><ellipse cx="1020" cy="260" rx="160" ry="260" fill="#8fd3f3" /><ellipse cx="550" cy="860" rx="600" ry="120" fill="#7fd0f3" /><ellipse cx="1000" cy="30" rx="220" ry="80" fill="#6cc4ef" /><ellipse cx="120" cy="20" rx="220" ry="70" fill="#a9def6" /></g>
    <% for (var i = 0; i < 14; i++) { %><circle cx="<%= (40 + rnd() * 200).toFixed(0) %>" cy="<%= (rnd() * 520).toFixed(0) %>" r="<%= (4 + rnd() * 10).toFixed(1) %>" fill="none" stroke="#bfe8fb" stroke-width="3" /><% } %>
