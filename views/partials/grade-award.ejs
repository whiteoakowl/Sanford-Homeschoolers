    <g filter="url(#ga-glow-<%= U %>)"><%- star(150, 120, 26, 'none', 0, ' stroke="#ffe14d" stroke-width="5"') %><%- star(960, 150, 22, 'none', 0, ' stroke="#ff3fd2" stroke-width="5"') %><%- star(110, 720, 24, 'none', 0, ' stroke="#3fd7ff" stroke-width="5"') %><%- star(990, 720, 26, 'none', 0, ' stroke="#ffe14d" stroke-width="5"') %><%- star(300, 220, 14, '#3fd7ff') %><%- star(820, 230, 14, '#ff3fd2') %></g>
  <% } else if (A.design === 'paint') { %>
    <rect width="1100" height="850" fill="#ffffff" />
    <%- splat(80, 90, 90, '#7e3ff2') %><%- splat(200, 40, 60, '#ffd53d') %><%- splat(40, 260, 60, '#2fa8f0') %><%- splat(60, 760, 100, '#ff9f1c') %><%- splat(190, 830, 70, '#36c46b') %><%- splat(40, 560, 60, '#ff4b6e') %>
    <%- splat(1030, 800, 100, '#36c46b') %><%- splat(900, 840, 70, '#2fa8f0') %><%- splat(1060, 560, 60, '#ffd53d') %><%- splat(1060, 380, 50, '#ff4b6e') %><%- splat(560, 0, 50, '#2fa8f0') %><%- splat(380, 40, 40, '#ff4b6e') %>
    <g transform="translate(920 150) rotate(-15)"><path d="M -130 0 C -130 -90, 40 -110, 120 -50 C 170 -10, 150 70, 80 80 C 40 85, 50 40, 10 45 C -30 50, -10 100, -60 95 C -110 90, -130 50, -130 0 Z" fill="#e8c48a" stroke="#a07a3e" stroke-width="5" /><circle cx="-80" cy="-30" r="20" fill="#ff4b6e" /><circle cx="-30" cy="-60" r="20" fill="#ffd53d" /><circle cx="30" cy="-62" r="20" fill="#36c46b" /><circle cx="85" cy="-30" r="20" fill="#2fa8f0" /><circle cx="-85" cy="35" r="18" fill="#7e3ff2" /><ellipse cx="-20" cy="20" rx="22" ry="16" fill="#fff" stroke="#a07a3e" stroke-width="3" /></g>
    <g transform="translate(990 70) rotate(35)"><rect x="-8" y="-10" width="16" height="170" rx="6" fill="#c0392b" /><rect x="-10" y="-40" width="20" height="35" fill="#bdc3c7" /><path d="M -10 -40 Q 0 -90 10 -40 Z" fill="#2c3e50" /></g>
    <g transform="translate(1030 110) rotate(55)"><rect x="-7" y="-10" width="14" height="150" rx="6" fill="#2980b9" /><rect x="-9" y="-36" width="18" height="30" fill="#bdc3c7" /><path d="M -9 -36 Q 0 -80 9 -36 Z" fill="#8e44ad" /></g>
  <% } else if (A.design === 'city') { %>
    <defs><linearGradient id="ga-sky-<%= U %>" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4b3b8f" /><stop offset="0.45" stop-color="#c06aa0" /><stop offset="0.8" stop-color="#f5a35c" /><stop offset="1" stop-color="#fff2e0" /></linearGradient></defs>
    <rect width="1100" height="850" fill="#f5f2fb" />
    <rect width="1100" height="300" fill="url(#ga-sky-<%= U %>)" />
    <% function skyline(base, h, color, flip) { var x = 0, s = ''; var widths = [60, 80, 50, 90, 70, 110, 60, 75, 95, 55, 85, 65, 100, 70, 60]; widths.forEach(function(w, i) { var hh = h * (0.45 + ((i * 53) % 55) / 100); s += '<rect x="' + x + '" y="' + (flip ? base : base - hh) + '" width="' + (w - 6) + '" height="' + hh + '" fill="' + color + '" />'; if (!flip) { for (var r = 0; r < hh / 30 - 1; r++) { for (var c = 0; c < (w - 6) / 18 - 1; c++) { if ((r + c + i) % 3) s += '<rect x="' + (x + 8 + c * 18) + '" y="' + (base - hh + 12 + r * 30) + '" width="8" height="12" fill="#ffd77a" opacity="0.8" />'; } } } x += w; }); return s; } %>
    <%- skyline(300, 170, '#2a2350', false) %>
    <%- skyline(850, 150, '#232044', false) %>
    <%- gradCap(550, 95, 120, '#171717', '#f2c14e') %>
    <% for (var i = 0; i < 18; i++) { %><circle cx="<%= (rnd() * 1100).toFixed(0) %>" cy="<%= (rnd() * 120).toFixed(0) %>" r="2" fill="#fff" opacity="0.8" /><% } %>
  <% } else if (A.design === 'goldstars') { %>
    <defs><linearGradient id="ga-gold-<%= U %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f7d774" /><stop offset="0.5" stop-color="#d4a017" /><stop offset="1" stop-color="#b8860b" /></linearGradient></defs>
    <rect width="1100" height="850" fill="#fffaf0" />
    <rect x="22" y="22" width="1056" height="806" rx="18" fill="none" stroke="url(#ga-gold-<%= U %>)" stroke-width="14" />
    <rect x="44" y="44" width="1012" height="762" rx="12" fill="none" stroke="#d4a017" stroke-width="3" />
    <path d="M 60 760 C 200 640, 120 460, 230 330 C 300 250, 260 140, 360 80" stroke="url(#ga-gold-<%= U %>)" stroke-width="16" fill="none" stroke-linecap="round" opacity="0.85" />
    <path d="M 1040 760 C 900 640, 980 460, 870 330 C 800 250, 840 140, 740 80" stroke="url(#ga-gold-<%= U %>)" stroke-width="16" fill="none" stroke-linecap="round" opacity="0.85" />
    <%- star(120, 120, 46, 'url(#ga-gold-' + U + ')') %><%- star(980, 120, 46, 'url(#ga-gold-' + U + ')') %><%- star(260, 220, 22, 'url(#ga-gold-' + U + ')') %><%- star(840, 230, 22, 'url(#ga-gold-' + U + ')') %><%- star(130, 470, 26, 'url(#ga-gold-' + U + ')') %><%- star(970, 470, 26, 'url(#ga-gold-' + U + ')') %><%- star(140, 720, 30, 'url(#ga-gold-' + U + ')') %><%- star(960, 720, 30, 'url(#ga-gold-' + U + ')') %><%- star(380, 150, 14, '#d4a017') %><%- star(720, 150, 14, '#d4a017') %>
    <%- gradCap(550, 105, 110, '#151515', '#d4a017') %>
  <% } else if (A.design === 'laurel') { %>
    <defs><linearGradient id="ga-blue-<%= U %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1d3f8f" /><stop offset="1" stop-color="#0d2156" /></linearGradient></defs>
    <rect width="1100" height="850" fill="url(#ga-blue-<%= U %>)" />
    <path d="M 70 60 Q 550 10 1030 60 L 1050 790 Q 550 840 50 790 Z" fill="#eef3fb" stroke="#d4a72c" stroke-width="8" />
    <path d="M 95 85 Q 550 40 1005 85 L 1022 768 Q 550 812 78 768 Z" fill="none" stroke="#d4a72c" stroke-width="3" />
    <% function laurel(cx, flip) { var s = '<path d="M ' + cx + ' 760 Q ' + (cx + (flip ? -80 : 80)) + ' 560 ' + (cx + (flip ? -30 : 30)) + ' 360" stroke="#c9971f" stroke-width="7" fill="none" />'; for (var k = 0; k < 9; k++) { var y = 740 - k * 44, x = cx + (flip ? -1 : 1) * (60 - Math.abs(k - 4) * 12); s += leaf(x - 22, y, 30, flip ? 150 : 30, '#d9a82e') + leaf(x + 22, y - 8, 30, flip ? 210 : -30, '#e9bf4a'); } return s; } %>
