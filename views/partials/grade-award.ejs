  </g>
  <g>
    <rect x="310" y="545" width="480" height="235" rx="34" fill="<%= T.panel %>" fill-opacity="<%= T.po %>" />
    <g font-family="'Oswald', 'Arial Narrow', sans-serif" font-weight="500" fill="<%= T.label || '#222' %>">
