<%
// A real request: grade level awards that "look exact" to the 15 example
// designs. Each award's artwork is the example's own artwork with the
// printed words taken out, widened to a landscape page and upscaled for
// print (public/img/awards/<design>.jpg). The words are drawn on top in
// the same place, size and color as the example, so any grade level and
// any names can go on any design. Drawn as one 1100 x 850 picture - the
// shape of a landscape letter page.
// Locals: award (utils/gradeAwards.js awardFromQuery), optional uid.
var A = award;
var U = (locals.uid || 'ga') + '-' + A.design;
// Each design's own text bands (fractions of the page height, measured
// off the example): Congratulations top/bottom, the grade line's bottom,
// and the name panel's bottom - plus, where the art's own name panel
// starts lower than that, the panel's top.
var PANEL_TOP = { rocket: 0.705, neon: 0.705, blackgold: 0.705 };
var L = {
  rainbow:   [0.245, 0.47, 0.665, 0.975],
  bee:       [0.245, 0.47, 0.665, 0.975],
  apple:     [0.19, 0.45, 0.645, 0.88],
  rocket:    [0.255, 0.53, 0.67, 0.975],
  dinosaur:  [0.345, 0.575, 0.715, 0.975],
  turtle:    [0.225, 0.48, 0.665, 0.975],
  sports:    [0.235, 0.48, 0.665, 0.97],
  butterfly: [0.235, 0.48, 0.665, 0.975],
  mountains: [0.245, 0.48, 0.665, 0.975],
  neon:      [0.255, 0.50, 0.665, 0.975],
  paint:     [0.235, 0.47, 0.645, 0.975],
  city:      [0.245, 0.48, 0.655, 0.975],
  goldstars: [0.235, 0.47, 0.655, 0.975],
  laurel:    [0.205, 0.45, 0.645, 0.975],
  blackgold: [0.235, 0.47, 0.655, 0.975],
}[A.design];
// Text colors from the examples: Congratulations (and its outline), You
// finished, the grade, and the name panel's labels/lines.
var T = {
  rainbow:   { c: '#1c3a7a', cs: '#ffffff', f: '#7d2fb8', g: '#7a22b5', lab: '#1d1d1d' },
  bee:       { c: '#161616', cs: '#ffffff', f: '#2e7d32', g: '#2a7a2c', lab: '#1d1d1d' },
  apple:     { c: '#161616', cs: '#ffffff', f: '#c8261c', g: '#c81e14', lab: '#1d1d1d' },
  rocket:    { c: '#ffffff', cs: '#0d1d4a', f: '#ffffff', g: '#ffd23f', lab: '#1b2a55', dark: true },
  dinosaur:  { c: '#1e3b1c', cs: '#ffffff', f: '#2d7a2a', g: '#1f5e1d', lab: '#1d1d1d' },
  turtle:    { c: '#13336b', cs: '#ffffff', f: '#16407a', g: '#16407a', lab: '#1d1d1d' },
  sports:    { c: '#161616', cs: '#ffffff', f: '#e0761c', g: '#e06d10', lab: '#1d1d1d' },
  butterfly: { c: '#5b2a8c', cs: '#ffffff', f: '#7b2fae', g: '#7322a8', lab: '#1d1d1d' },
  mountains: { c: '#16240f', cs: '#ffffff', f: '#2f7d2a', g: '#1f5e1a', lab: '#1d1d1d' },
  neon:      { c: '#ffffff', cs: '#2a1a6e', f: '#4fe0ff', g: '#4fe0ff', lab: '#1b2a55', dark: true, glow: true },
  paint:     { c: '#4b1d78', cs: '#ffffff', f: '#4b1d78', g: '#43186f', lab: '#1d1d1d' },
  city:      { c: '#1c2340', cs: '#ffffff', f: '#1c2340', g: '#151a33', lab: '#1d1d1d' },
  goldstars: { c: '#3a2a12', cs: '#ffffff', f: '#c8901a', g: '#c2810c', lab: '#1d1d1d' },
  laurel:    { c: '#1a3a8a', cs: '#ffffff', f: '#1a3a8a', g: '#14306b', lab: '#14306b' },
  blackgold: { c: '#f0c050', cs: '#2a1e05', f: '#f0c050', g: '#f0c050', lab: '#2a1e05', dark: true },
}[A.design];
var H = 850;
var congratsY = ((L[0] + L[1]) / 2) * H + 34;
var finishedY = (L[1] + (L[2] - L[1]) * 0.3) * H + 18;
var gradeY = (L[1] + (L[2] - L[1]) * 0.8) * H + 22;
var pTop = PANEL_TOP[A.design] || L[2];
var p = function (f) { return (pTop + (L[3] - pTop) * f) * H; };
var labelY = p(0.22), line1 = p(0.45), line2 = p(0.68), line3 = p(0.91);
var gradeSize = A.gradeDisplay.length > 12 ? 82 : 90;
%>
<svg class="grade-award grade-award-<%= A.design %>" viewBox="0 0 1100 850" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Congratulations! You finished <%= A.gradeLabel %>">
  <defs>
    <filter id="ga-shadow-<%= U %>" x="-10%" y="-10%" width="120%" height="140%"><feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#000" flood-opacity="0.28" /></filter>
    <filter id="ga-glow-<%= U %>" x="-20%" y="-30%" width="140%" height="160%"><feGaussianBlur stdDeviation="7" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    <path id="ga-arc-<%= U %>" d="M 190 <%= congratsY + 12 %> Q 550 <%= congratsY - 30 %> 910 <%= congratsY + 12 %>" />
  </defs>
  <image href="/img/awards/<%= A.design %>.jpg" x="0" y="0" width="1100" height="850" preserveAspectRatio="xMidYMid slice" />

  <g font-family="'Kaushan Script', 'Brush Script MT', cursive" text-anchor="middle"<% if (T.glow) { %> filter="url(#ga-glow-<%= U %>)"<% } %>>
    <text font-size="104" fill="<%= T.c %>" stroke="<%= T.cs %>" stroke-width="10" stroke-linejoin="round" paint-order="stroke" textLength="720" lengthAdjust="spacingAndGlyphs"<% if (!T.glow) { %> filter="url(#ga-shadow-<%= U %>)"<% } %>><textPath href="#ga-arc-<%= U %>" startOffset="50%">Congratulations</textPath></text>
  </g>
  <g font-family="'Baloo 2', 'Arial Rounded MT Bold', sans-serif" font-weight="800" text-anchor="middle"<% if (T.glow) { %> filter="url(#ga-glow-<%= U %>)"<% } %>>
    <text x="550" y="<%= finishedY %>" font-size="58" fill="<%= T.f %>"<% if (!T.dark) { %> stroke="#ffffff" stroke-width="6" paint-order="stroke"<% } %>>You finished</text>
    <text x="550" y="<%= gradeY %>" font-size="<%= gradeSize %>" fill="<%= T.g %>"<% if (!T.dark) { %> stroke="#ffffff" stroke-width="7" paint-order="stroke"<% } else { %> filter="url(#ga-shadow-<%= U %>)"<% } %>><%= A.gradeDisplay %></text>
  </g>

  <g font-family="'Open Sans', Arial, sans-serif" font-weight="700" fill="<%= T.lab %>">
    <text x="550" y="<%= labelY %>" font-size="25" text-anchor="middle">Student Name:</text>
    <line x1="385" y1="<%= line1 %>" x2="715" y2="<%= line1 %>" stroke="<%= T.lab %>" stroke-width="2" />
    <text x="385" y="<%= line2 - 3 %>" font-size="21">Parent/Teacher:</text>
    <line x1="560" y1="<%= line2 %>" x2="715" y2="<%= line2 %>" stroke="<%= T.lab %>" stroke-width="2" />
    <text x="385" y="<%= line3 - 3 %>" font-size="21">Parent/Teacher:</text>
    <line x1="560" y1="<%= line3 %>" x2="715" y2="<%= line3 %>" stroke="<%= T.lab %>" stroke-width="2" />
  </g>
  <g font-family="'Caveat', 'Segoe Print', cursive" font-weight="700" fill="#1b2a55" text-anchor="middle">
    <% if (A.studentName) { %><text x="550" y="<%= line1 - 8 %>" font-size="44" textLength="<%= Math.min(320, A.studentName.length * 21) %>" lengthAdjust="spacingAndGlyphs"><%= A.studentName %></text><% } %>
    <% if (A.parent1) { %><text x="637" y="<%= line2 - 6 %>" font-size="32" textLength="<%= Math.min(150, A.parent1.length * 14) %>" lengthAdjust="spacingAndGlyphs"><%= A.parent1 %></text><% } %>
    <% if (A.parent2) { %><text x="637" y="<%= line3 - 6 %>" font-size="32" textLength="<%= Math.min(150, A.parent2.length * 14) %>" lengthAdjust="spacingAndGlyphs"><%= A.parent2 %></text><% } %>
  </g>
</svg>
