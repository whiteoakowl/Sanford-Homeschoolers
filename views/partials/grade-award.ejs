    <% [[60,850,['#ff7043','#ef5350']],[160,850,['#ec407a','#ab47bc']],[960,850,['#ff7043','#ffb300']],[1060,850,['#ef5350','#26a69a']]].forEach(function(c) { %>
      <path d="M <%= c[0] %> <%= c[1] %> L <%= c[0] %> <%= c[1] - 200 %> M <%= c[0] %> <%= c[1] - 100 %> L <%= c[0] - 45 %> <%= c[1] - 180 %> M <%= c[0] %> <%= c[1] - 140 %> L <%= c[0] + 45 %> <%= c[1] - 230 %> M <%= c[0] - 45 %> <%= c[1] - 180 %> L <%= c[0] - 60 %> <%= c[1] - 230 %>" stroke="<%= c[2][0] %>" stroke-width="18" stroke-linecap="round" fill="none" />
      <path d="M <%= c[0] + 20 %> <%= c[1] %> Q <%= c[0] + 60 %> <%= c[1] - 120 %> <%= c[0] + 30 %> <%= c[1] - 240 %>" stroke="<%= c[2][1] %>" stroke-width="12" stroke-linecap="round" fill="none" />
    <% }); %>
    <path d="M 900 330 Q 940 200 900 60 M 935 330 Q 985 220 960 80 M 1040 360 Q 1000 240 1050 100" stroke="#2e9b6a" stroke-width="14" fill="none" stroke-linecap="round" opacity="0.85" />
  <% } else if (A.design === 'sports') { %>
