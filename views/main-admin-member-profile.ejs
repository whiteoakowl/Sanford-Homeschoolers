<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# The Profile tab's own member-profile-card partial below already
        carries a "Member Profile" banner with its own Back/Edit links -
        this older subtitle+h1+Edit toolbar stays for Schedule/Attendance
        (which have no banner of their own), skipped on Profile so the
        two headers don't show side by side. %>
    <% if (tab !== 'profile') { %>
      <p class="subtitle no-print"><a href="<%= membersBackHref %>">&larr; Members</a></p>
      <div class="roster-toolbar">
        <h1><%= member.name %><% if (member.member_type === 'admin') { %> <span class="member-admin-star" title="Admin"><svg class="icon"><use href="#icon-star"/></svg></span><% } %></h1>
        <a class="primary-btn no-print" href="/main-admin/members/<%= member.id %>/edit"><svg class="icon"><use href="#icon-edit"/></svg> Edit</a>
      </div>
    <% } %>

    <%# One specific member's own Profile/Class Schedule/Attendance tabs -
        no top-level nav entry to attach a popup to (reached by clicking
        into a member, not from the nav), so this stays the plain
        connected file-tab strip every other tabbed page used before the
        orange-bar popup existed, instead of a popup with nothing to open
        it from. %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'profile' ? ' active' : '' %>" href="/main-admin/members/<%= member.id %>?tab=profile">Profile</a>
      <a class="view-tab<%= tab === 'schedule' ? ' active' : '' %>" href="/main-admin/members/<%= member.id %>?tab=schedule">Class Schedule</a>
      <a class="view-tab<%= tab === 'attendance' ? ' active' : '' %>" href="/main-admin/members/<%= member.id %>?tab=attendance">Attendance</a>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'profile') { %>
        <%
        // A real request: "there should not be an edit permissions
        // button, it should just show the members sections and portal
        // permissions. When you click the edit button on the member's
        // profile that is where you can control portal settings per
        // member." Read-only here on purpose - editing happens on
        // /main-admin/members/:id/edit's own Portal Settings box.
        //
        // A real request: "the family should be a list in a nice column
        // with parents listed under parent title, and children listed
        // under children title. Should show grade levels next to
        // students in parenthesis." Admins count as "Parents" here too
        // (both are adults) - member_type === 'student' is the only
        // thing that puts someone under Children.
        var famParents = familyMembers.filter(function(m) { return m.member_type !== 'student'; });
        var famChildren = familyMembers.filter(function(m) { return m.member_type === 'student'; });
        %>
        <%- include('partials/member-profile-card', {
          member,
          familyName,
          famParents,
          famChildren,
          memberSections,
          memberPortalRoles,
          backHref: membersBackHref,
          backLabel: 'Back to Members',
          editHref: '/main-admin/members/' + member.id + '/edit',
          familyMemberHref: function(id) { return '/main-admin/members/' + id; },
        }) %>
      <% } else if (tab === 'schedule') { %>
        <% if (familyRoster.length > 1) { %>
          <div class="category-filter member-profile-family-select">
            <label for="schedule-family-member-select">Family Member</label>
            <select id="schedule-family-member-select" onchange="if (this.value === 'all') { window.location = '/main-admin/members/<%= member.id %>?tab=schedule&family=all'; } else { window.location = '/main-admin/members/' + this.value + '?tab=schedule'; }">
              <option value="all" <%= scheduleFamilyAll ? 'selected' : '' %>>All</option>
              <% familyRoster.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= (!scheduleFamilyAll && m.id === member.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <%# A real request: "member profile, schedules should also look
            like this [image]" - the same shared member-schedule-table
            as Co-op Admin's own profile (views/admin-member-profile.ejs),
            one section per family member for "All", with the Export/
            PDF/Print row at the top covering exactly what's shown. %>
        <% var scheduleQuery = scheduleFamilyAll ? 'familyId=' + member.family_id : 'memberId=' + member.id; %>
        <%- include('partials/member-schedule-actions', {
          exportHref: '/main-admin/members/schedule-export.csv?' + scheduleQuery,
          pdfHref: '/main-admin/members/schedule-download.pdf?' + scheduleQuery,
          printHref: '/main-admin/members/schedule-print?' + scheduleQuery,
        }) %>
        <%- include('partials/member-schedule-table', { tables: scheduleTables, memberHref: function (m) { return scheduleFamilyAll && m.id !== member.id ? '/main-admin/members/' + m.id + '?tab=schedule' : null; } }) %>
      <%# A real request: "print whole family schedule... Rosters doesn't
          need to be on this page at all." The Rosters list that used to
          sit here (which schedule/attendance rosters this member is on)
          is gone - unrelated to the actual class schedule this tab shows. %>
      <% } else { %>
        <% if (familyRoster.length > 1) { %>
          <div class="category-filter member-profile-family-select">
            <label for="attendance-family-member-select">Family Member</label>
            <select id="attendance-family-member-select" onchange="if (this.value === 'all') { window.location = '/main-admin/members/<%= member.id %>?tab=attendance&family=all'; } else { window.location = '/main-admin/members/' + this.value + '?tab=attendance'; }">
              <option value="all" <%= attendanceFamilyAll ? 'selected' : '' %>>All</option>
              <% familyRoster.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= (!attendanceFamilyAll && m.id === member.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <% if (attendanceFamilyAll) { %>
          <% familyAttendanceHistories.forEach(function(fa) { %>
            <div class="form-section member-profile-family-schedule">
              <h2 class="member-profile-family-schedule-name"><%= fa.member.name %></h2>
              <%- include('partials/member-attendance-rosters', { groups: fa.history, uidPrefix: 'fa-member-' + fa.member.id, includeNumberColumn: false }) %>
            </div>
          <% }); %>
        <% } else { %>
          <%- include('partials/member-attendance-rosters', { groups: history, uidPrefix: 'member-' + member.id, includeNumberColumn: false }) %>
          <p class="hint">Most recent 25 records.</p>
        <% } %>
      <% } %>
    </div>
  </main>
  <script src="/js/member-attendance-accordion.js"></script>
</body>
</html>
