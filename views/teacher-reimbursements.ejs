<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Co-op Teacher Portal' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar">
      <h1>Reimbursements</h1>
      <div class="roster-btn-row roster-btn-row-fit-text">
        <a class="roster-action-btn roster-action-btn-fit" href="/teacher/reimbursements/new">+ Fill Out Reimbursement Form</a>
      </div>
    </div>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (requests.length === 0) { %>
      <p class="roster-empty">You haven't submitted any reimbursement forms yet.</p>
    <% } else { %>
      <table class="roster-table condensed-table reimbursement-log-table">
        <thead>
          <tr><th>Submitted</th><th>Name</th><th>Semester</th><th>Day</th><th>Class</th><th>Items</th><th>Receipts</th><th class="reimbursement-amount-col">Total</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% requests.forEach(function(r) { %>
            <tr>
              <td><a href="/teacher/reimbursements/<%= r.id %>"><%= formatTimestamp(r.submitted_at) %></a></td>
              <td><%= r.member_name %></td>
              <td><%= r.semester_title %></td>
              <td><%= r.dayLabel %></td>
              <td><%= r.class_name %></td>
              <td><%= r.itemCount %></td>
              <td><%= r.receiptCount %></td>
              <td class="reimbursement-amount-col"><%= r.totalLabel %></td>
              <td><span class="reimbursement-status reimbursement-status-<%= r.status %>"><%= r.statusLabel %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
