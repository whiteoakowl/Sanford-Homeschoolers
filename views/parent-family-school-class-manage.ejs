<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school/classes">&larr; Family Classes</a></p>
    <div class="roster-toolbar no-print">
      <h1><%= cls.class_name %></h1>
      <div class="roster-btn-row">
        <form method="POST" action="/parent/family-school/classes/<%= cls.id %>/delete" data-confirm="Delete the class &quot;<%= cls.class_name %>&quot;? This also removes its lessons and content tied to it. This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Class</button>
        </form>
      </div>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Class Details</h2>
      </div>
      <form method="POST" action="/parent/family-school/classes/<%= cls.id %>/edit" class="member-form-grid">
        <label class="member-form-full">Class Name
          <input type="text" name="className" value="<%= cls.class_name %>" required />
        </label>
        <label class="member-form-full">Description
          <textarea name="description" rows="2"><%= cls.description || '' %></textarea>
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Save Class Details</button>
        </div>
      </form>
    </div>

    <%# "assign these classes to their own students in their family." A
        plain checkbox set of this family's own students - unassigned by
        default, same "pick from a checkbox list, post the whole set"
        shape assignClassToStudents (utils/familySchool.js) expects. %>
    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Assigned Students</h2>
      </div>
      <% if (familyStudents.length === 0) { %>
        <p class="roster-empty">No students in your family yet.</p>
      <% } else { %>
        <form method="POST" action="/parent/family-school/classes/<%= cls.id %>/students" class="stack-form">
          <% familyStudents.forEach(function(s) { %>
            <label class="checkbox-option">
              <input type="checkbox" name="studentIds" value="<%= s.id %>" <%= assignedStudents.some(function(a) { return a.id === s.id; }) ? 'checked' : '' %> />
              <%= s.name %>
            </label>
          <% }); %>
          <div>
            <button type="submit" class="primary-btn">Save Assigned Students</button>
          </div>
        </form>
      <% } %>
    </div>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Lessons (<%= lessons.length %>)</h2>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-lesson-dialog').showModal()">+ New Lesson</button>
      </div>
      <%# A real request: the same lesson/assignment design as the Teacher
          Portal - each lesson is a bar; opening it shows that lesson's
          own + Add Assignments and assignments. %>
      <% if (lessons.length === 0) { %>
        <p class="roster-empty">No lessons yet. Click + New Lesson to add the first one.</p>
      <% } %>
      <div class="lesson-plan-bars">
        <% lessons.forEach(function(l) { %>
          <% var lessonReturnTo = '/parent/family-school/classes/' + cls.id + '?open=' + l.id; %>
          <details class="lesson-plan-bar" id="lesson-<%= l.id %>" <%= openLessonId === l.id ? 'open' : '' %>>
            <summary>
              <span class="lesson-plan-bar-title"><%= l.title %></span>
              <span class="lesson-plan-bar-meta">
                <span class="hint"><%= l.contentItems.length %> assignment<%= l.contentItems.length === 1 ? '' : 's' %></span>
                <% if (l.sourcePlan) { %><span class="hint">From the library</span><% } %>
              </span>
            </summary>
            <div class="lesson-plan-bar-body">
              <% if (l.description) { %><p class="hint plain-text-display"><%= l.description %></p><% } %>
              <div class="roster-btn-row no-print">
                <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-lesson-dialog-<%= l.id %>').showModal()">Edit Lesson</button>
                <a class="roster-action-btn" href="/parent/family-school/lessons/<%= l.id %>">Submissions &amp; Grades</a>
                <form method="POST" action="/parent/family-school/lessons/<%= l.id %>/delete" data-confirm="Delete the lesson &quot;<%= l.title %>&quot;? This also removes its content, submissions, and grades. This cannot be undone.">
                  <button type="submit" class="roster-action-btn">Delete Lesson</button>
                </form>
              </div>
              <%- include('partials/family-school-content-manage', { lesson: l, contentItems: l.contentItems, sourcePlan: l.sourcePlan, sourcePlanLocked: l.sourcePlanLocked, basePath: '/parent/family-school', showDetails: false, idSuffix: l.id, returnTo: lessonReturnTo, includeScripts: false }) %>
              <dialog id="edit-lesson-dialog-<%= l.id %>" class="member-picker-dialog dialog-label-stack">
                <form method="POST" action="/parent/family-school/lessons/<%= l.id %>/edit" class="member-form-grid">
                  <input type="hidden" name="returnTo" value="<%= lessonReturnTo %>" />
                  <h3>Edit Lesson</h3>
                  <label class="member-form-full">Title
                    <input type="text" name="title" value="<%= l.title %>" required />
                  </label>
                  <label class="member-form-full">Description
                    <textarea name="description" rows="3"><%= l.description || '' %></textarea>
                  </label>
                  <div class="notes-dialog-actions">
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            </div>
          </details>
        <% }); %>
      </div>
    </div>
  </main>

  <%# A real request: "Family school management tab, subpage, pages,
      popups etc. Make sure all buttons, text bars, lists etc all have
      adequate space between rows and no overlapping." Same missing-
      .stack-form bug as the New Class dialog (parent-family-school-
      classes.ejs's own comment on this) - this dialog's bare <label>
      elements had no display:block or row spacing of their own. %>
  <%# A real request: "Lesson plans... Be able to make lesson plans
      available for parents to use to assign to students under family
      school management, family classes." Source toggles the dialog
      between the original "write my own" fields and a picker over the
      admin's own Lesson Plans library (every plan is eligible - see
      routes/parent-family-school.js's own comment on why there's no
      separate visibility flag to filter this by) - same show/hide-by-
      dropdown-value behavior as the Add Content dialog below's own
      Type field (public/js/lesson-content-form.js), reused here as-is. %>
  <dialog id="add-lesson-dialog" class="class-form-dialog">
    <form method="POST" action="/parent/family-school/classes/<%= cls.id %>/lessons" class="stack-form" data-toggle-form>
      <div class="class-form-dialog-header">
        <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
        <h3>New Lesson</h3>
      </div>
      <label>Source
        <select name="source" data-toggle-select>
          <option value="own">Write my own</option>
          <option value="plan">Choose from Lesson Plans library</option>
        </select>
      </label>
      <label data-toggle-field="own">Title
        <input type="text" name="title" />
      </label>
      <label data-toggle-field="own">Description
        <textarea name="description" rows="2"></textarea>
      </label>
      <label data-toggle-field="plan" style="display: none;">Lesson Plan
        <select name="lessonPlanId">
          <option value="">Choose a lesson plan&hellip;</option>
          <% lessonPlans.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.title %><%= p.family_id ? " (My Family's Copy)" : '' %><%= p.locked ? ' (Locked)' : '' %></option>
          <% }); %>
        </select>
      </label>
      <p class="hint" data-toggle-field="plan" style="display: none;">
        <% if (lessonPlans.length === 0) { %>
          No lesson plans are in the library yet.
        <% } else { %>
          Its content comes straight from the library and can't be edited here - you can remove the link later without changing the original.
        <% } %>
      </p>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="submit" class="primary-btn">Create Lesson</button>
      </div>
    </form>
  </dialog>
  <script src="/js/lesson-drag-reorder.js"></script>
  <script src="/js/lesson-content-form.js"></script>
  <script src="/js/assignment-upload-word-count.js"></script>
  <script src="/js/forum-editor.js"></script>
</body>
</html>
