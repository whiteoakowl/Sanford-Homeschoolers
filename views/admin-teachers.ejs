<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar no-print">
      <h1><%= title %></h1>
      <%# A real request: "teacher and assistant subpages are seperate and
          should be combined, with a pill toggle to switch between teachers
          and assistants" - same pill as Attendance's Parent/Student. %>
      <% var semQ = selectedSemesterId ? '&semesterId=' + selectedSemesterId : (selectedSemesterId === null ? '&semesterId=' : ''); %>
      <div class="day-toggle staff-role-toggle" role="group" aria-label="Teachers or assistants">
        <a class="day-toggle-option<%= role === 'teacher' ? ' active' : '' %>" href="/admin/teachers?role=teacher<%= semQ %>" aria-current="<%= role === 'teacher' ? 'page' : 'false' %>">Teachers</a>
        <a class="day-toggle-option<%= role === 'assistant' ? ' active' : '' %>" href="/admin/teachers?role=assistant<%= semQ %>" aria-current="<%= role === 'assistant' ? 'page' : 'false' %>">Assistants</a>
      </div>
      <div class="roster-btn-row">
        <%# A real request: "organized by schedule grid semester with a
            dropdown filter" - a plain Semester-only select, same shape as
            the Classes grid's own standalone Semester filter (views/
            partials/class-schedule-grid.ejs) - NOT the shared semester+
            day combo picker (partials/schedule-combo-picker.ejs), since
            this list spans every day at once per teacher rather than
            showing one day's own grid. basePath (routes/admin-teachers.js)
            points this back at whichever of the two role-scoped pages
            it's actually on - a later real request split this single
            page into GET /teachers and GET /teachers/assistants. %>
        <form method="GET" action="<%= basePath %>" class="category-filter">
          <input type="hidden" name="role" value="<%= role %>" />
          <label for="teachers-semester-select">Semester</label>
          <select id="teachers-semester-select" name="semesterId" onchange="this.form.submit()">
            <option value="" <%= !selectedSemesterId ? 'selected' : '' %>>All Semesters</option>
            <% semesters.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= selectedSemesterId === s.id ? 'selected' : '' %>><%= s.title %></option>
            <% }); %>
          </select>
        </form>
      </div>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No <%= roleLabel %>s are staffed on a class<%= selectedSemesterId ? ' for this semester' : '' %> yet.</p>
    <% } else { %>
      <%# A real follow-up request: "even if the member is only teaching or
          assisting 1 class it should still show as a drop down minimize
          system so that you see just a list of member names" - every
          member now gets the same <details>/<summary> collapsible
          treatment regardless of class count, so the collapsed page
          reads as a clean list of names only; a single-class member's
          <details> just happens to hold one <li> once expanded.
          "Organized alphabetical by last name" - members is already
          byLastName-sorted server-side (routes/admin-teachers.js). %>
      <ul class="teacher-list">
        <% members.forEach(function(m) { %>
          <li class="teacher-list-item">
            <details>
              <summary><%= m.name %> <span class="teacher-class-count"><%= [m.teachingCount ? m.teachingCount + ' teaching' : '', m.assistingCount ? m.assistingCount + ' assisting' : ''].filter(Boolean).join(' · ') %></span></summary>
              <ul class="teacher-class-list">
                <% m.classes.forEach(function(c) { %>
                  <%# A real request: "You can click on the class and it
                      will go to the class" - a full admin goes straight
                      to the class's own tabbed manage page (same click
                      target the Classes grid's own cards already use,
                      public/js/class-schedule-view.js), but that page
                      is requireFullAdmin-gated; a non-full Co-op Admin
                      (who can still see this list at all - see admin-
                      nav.ejs's own comment) instead lands on that
                      class's own day grid, the closest a read-only
                      viewer can actually open. %>
                  <%# A later real request: a teacher's dropdown "will also
                      show any classes they are assisting in so that we
                      know their full schedule" - each class is tagged
                      Teaching or Assisting again. %>
                  <li>
                    <a href="<%= isFullAdmin ? `/admin/class-schedule/classes/${c.id}/manage` : `/admin/schedule?tab=${c.day}${selectedSemesterId ? '&semesterId=' + selectedSemesterId : ''}` %>">
                      <span class="teacher-class-name"><%= c.className %> <span class="badge-pill <%= c.role === 'teacher' ? 'badge-pill-blue' : 'badge-pill-purple' %>"><%= c.roleLabel %></span></span>
                      <span class="teacher-class-meta"><%= c.dayLabel %><%= c.timeLabel ? ' · ' + c.timeLabel : '' %><%= c.room ? ' · ' + c.room : '' %></span>
                    </a>
                  </li>
                <% }); %>
              </ul>
            </details>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>
</body>
</html>
