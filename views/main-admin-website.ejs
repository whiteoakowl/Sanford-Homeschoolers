<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'website' }) %>

    <%# A real request: "switch that to wix." Wix's own site dashboard card:
        a live thumbnail of the site, its name and URL, a primary "Edit
        Site" button that opens the full-screen editor, and "View Site". %>
    <h1 class="site-dash-title">Public Homepage</h1>
    <div class="site-dash-card">
      <a class="site-dash-thumb" href="/main-admin/website/editor" aria-label="Edit site">
        <iframe src="/" title="Live site thumbnail" tabindex="-1" loading="lazy"></iframe>
      </a>
      <div class="site-dash-body">
        <div class="site-dash-info">
          <h2><%= siteName %></h2>
          <a class="site-dash-url" href="/" target="_blank" rel="noopener"><%= siteUrl %></a>
          <p class="hint">
            <%= pageCount %> page<%= pageCount === 1 ? '' : 's' %>
            <% if (publishedAt) { %> &middot; Last published <%= publishedAt %> UTC<% } %>
          </p>
          <% if (hasUnpublished) { %><span class="badge-pill site-dash-badge">Unpublished changes</span><% } %>
        </div>
        <div class="site-dash-actions">
          <a class="btn-secondary" href="/" target="_blank" rel="noopener">View Site</a>
          <a class="primary-btn" href="/main-admin/website/editor">Edit Site</a>
        </div>
      </div>
    </div>
    <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <%# A real request: "Customize the public homepage. Using the
        information in this photo..." %>
    <section class="manage-section site-dash-starter">
      <h2>Sanford Homeschoolers Pages</h2>
      <p class="hint">Loads a ready-made Home page (welcome, co-op classes on Wednesdays 9am&ndash;2pm, group activities, member features, upcoming events) plus Co-op Classes, Community and Contact pages with a contact form. They go into your draft only &mdash; review and edit them in the editor, then Publish. This replaces your current Home page.</p>
      <form method="POST" action="/main-admin/website/load-starter" data-confirm="Load the Sanford Homeschoolers pages into your draft? This replaces the draft Home page (and any Classes, Community or Contact page). Nothing goes live until you Publish." data-confirm-safe="1" data-confirm-yes-label="Yes, Load Pages">
        <button type="submit" class="roster-action-btn">Load the Sanford Homeschoolers Pages</button>
      </form>
    </section>
    <p class="hint site-dash-note">The site editor works best on a computer. Changes autosave as a draft &mdash; nothing goes live until you click <strong>Publish</strong> in the editor.</p>
  </main>
</body>
</html>
