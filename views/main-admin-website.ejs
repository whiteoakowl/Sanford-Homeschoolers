<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'website' }) %>

    <%# A real request: "switch that to wix." Wix's own site dashboard card:
        a live thumbnail of the site, its name and URL, a primary "Edit
        Site" button that opens the full-screen editor, and "View Site". %>
    <h1 class="site-dash-title">Public Homepage</h1>
    <div class="site-dash-card">
      <a class="site-dash-thumb" href="/main-admin/website/editor" aria-label="Edit site">
        <iframe src="/" title="Live site thumbnail" tabindex="-1" loading="lazy"></iframe>
      </a>
      <div class="site-dash-body">
        <div class="site-dash-info">
          <h2><%= siteName %></h2>
          <a class="site-dash-url" href="/" target="_blank" rel="noopener"><%= siteUrl %></a>
          <p class="hint">
            <%= pageCount %> page<%= pageCount === 1 ? '' : 's' %>
            <% if (publishedAt) { %> &middot; Last published <%= publishedAt %> UTC<% } %>
          </p>
          <% if (hasUnpublished) { %><span class="badge-pill site-dash-badge">Unpublished changes</span><% } %>
        </div>
        <div class="site-dash-actions">
          <a class="btn-secondary" href="/" target="_blank" rel="noopener">View Site</a>
          <a class="primary-btn" href="/main-admin/website/editor">Edit Site</a>
        </div>
      </div>
    </div>
    <p class="hint site-dash-note">The site editor works best on a computer. Changes autosave as a draft &mdash; nothing goes live until you click <strong>Publish</strong> in the editor.</p>
  </main>
</body>
</html>
