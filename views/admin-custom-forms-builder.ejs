<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>
<%
var buttonRadius = form.theme_button_style === 'pill' ? '999px' : form.theme_button_style === 'square' ? '4px' : '10px';
var currentThemePreset = themePresets.find(function(p) { return p.key === form.theme_preset; });
var isSettingsTab = activeTab === 'settings';
%>
  <%# Every field in the form, flat, for the conditional-logic rule
      builder's own "depends on" dropdown and its value-type lookup
      (public/js/custom-form-builder.js reads this to swap in a real
      <select> of a choice field's own options once one is picked as
      the condition's target). %>
  <script type="application/json" id="cf-field-meta"><%- JSON.stringify(Object.fromEntries(allFields.map(function(f) { return [f.id, { type: f.field_type, options: f.options.map(function(o){ return o.label; }) }]; }))) %></script>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= form.title %></h1>
      <span class="badge-pill badge-pill-<%= form.status === 'published' ? 'green' : form.status === 'closed' ? 'gray' : 'orange' %>"><%= form.status.charAt(0).toUpperCase() + form.status.slice(1) %></span>
    </div>
    <p><a href="/main-admin/forms">&larr; All Forms</a></p>

    <%- include('partials/custom-form-tabs', { form: form, activeTab: activeTab }) %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (isSettingsTab) { %>
      <%# Settings tab - a real request: "Move assigned to and
          draft/publish under the settings tab" - status controls, Delete,
          and Assign To live here now, off the Details tab. Settings &
          Theme (title/description/color/fonts) stays ON the Details tab
          instead (below) - "Details tab is the form edition and view,"
          and moving Settings & Theme off onto a separate page would
          break the live preview sitting right next to it (public/js/
          custom-form-live-preview.js needs both on the same page to
          update it with no Save first). %>
      <div class="cf-builder-sidebar">
        <div class="manage-section">
          <div class="grid-box-header"><h2>Status</h2></div>
          <div class="roster-btn-row">
            <% if (form.status !== 'published') { %>
              <form method="POST" action="/main-admin/forms/<%= form.id %>/status" class="inline-block-form">
                <input type="hidden" name="status" value="published" />
                <button type="submit" class="roster-action-btn">Publish</button>
              </form>
            <% } %>
            <% if (form.status !== 'closed') { %>
              <form method="POST" action="/main-admin/forms/<%= form.id %>/status" class="inline-block-form">
                <input type="hidden" name="status" value="closed" />
                <button type="submit" class="roster-action-btn roster-action-btn-danger">Close</button>
              </form>
            <% } else { %>
              <form method="POST" action="/main-admin/forms/<%= form.id %>/status" class="inline-block-form">
                <input type="hidden" name="status" value="draft" />
                <button type="submit" class="roster-action-btn">Move to Draft</button>
              </form>
            <% } %>
            <form method="POST" action="/main-admin/forms/<%= form.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= form.title %>&quot;? This removes every page, element, assignment, and submission. This cannot be undone.">
              <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Form</button>
            </form>
          </div>
        </div>

        <div class="manage-section">
          <div class="grid-box-header"><h2>Assign To (<%= assignments.length %>)</h2></div>
          <div class="training-lesson-list">
            <% assignments.forEach(function(a) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-<%= a.member_id ? 'user' : 'users' %>"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= a.memberName || a.roleLabel %></strong>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/forms/<%= form.id %>/assignments/<%= a.id %>/delete" class="inline-block-form">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Remove" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <form method="POST" action="/main-admin/forms/<%= form.id %>/assignments" class="roster-btn-row" style="margin-top: 0.75rem;">
            <select name="memberId">
              <option value="">Assign a specific person&hellip;</option>
              <% members.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
            </select>
            <span class="hint">or</span>
            <select name="roleId">
              <option value="">Assign a group&hellip;</option>
              <% roles.forEach(function(r) { %><option value="<%= r.id %>"><%= r.label %></option><% }); %>
            </select>
            <button type="submit" class="roster-action-btn">Assign</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <%# Details tab - a real request: "Add page and add element button
          top of page, side by side on the same row shrink to fit." One
          global Add Element dialog now (with its own Page picker,
          defaulting to the first page) instead of a separate dialog/
          button per page. %>
      <div class="cf-builder-toolbar roster-btn-row no-print">
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-page-dialog').showModal()">+ Add Page</button>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-element-dialog').showModal()">+ Add Element</button>
      </div>

      <div class="cf-builder-layout">
        <div class="cf-builder-sidebar">
          <div class="manage-section">
            <div class="grid-box-header"><h2>Settings &amp; Theme</h2></div>
            <form method="POST" action="/main-admin/forms/<%= form.id %>" class="member-form-grid" data-cf-settings-form>
              <label class="member-form-full">Title
                <input type="text" name="title" value="<%= form.title %>" required data-cf-theme-field />
              </label>
              <label class="member-form-full">Description
                <textarea name="description" rows="2" data-cf-theme-field><%= form.description || '' %></textarea>
              </label>
              <%# Per-form appearance - a real request: "full editing
                  features and view just like jotform, exactly" (Jotform's
                  own Theme tab, scoped to primary color + button shape).
                  Applied live on the preview panel just to the right
                  (public/js/custom-form-live-preview.js), and on the
                  public fill-out page (custom-forms-fill.ejs) once
                  saved. A later real request: "Be able to add fun
                  visual themes to custom forms, holidays, activities,
                  sports etc." - a preset just pre-fills Primary Color
                  (public/js/custom-form-builder.js) and adds its own
                  decorative emoji next to the form's title; Primary
                  Color stays freely editable after picking one, so it's
                  never a second, conflicting source of truth for color
                  (utils/customForms.js's own THEME_PRESETS). %>
              <label class="member-form-full">Fun Theme
                <select name="themePreset" data-cf-theme-preset-select data-cf-theme-field>
                  <% themePresets.forEach(function(p) { %>
                    <option value="<%= p.key %>" data-primary-color="<%= p.primaryColor %>" data-emoji="<%= p.emoji %>" <%= form.theme_preset === p.key ? 'selected' : '' %>><%= p.emoji ? p.emoji + ' ' : '' %><%= p.label %></option>
                  <% }); %>
                </select>
              </label>
              <label>Primary Color
                <input type="color" name="themePrimaryColor" value="<%= form.theme_primary_color %>" data-cf-primary-color-input data-cf-theme-field />
              </label>
              <label>Button Style
                <select name="themeButtonStyle" data-cf-theme-field>
                  <% themeButtonStyles.forEach(function(s) { %>
                    <option value="<%= s %>" <%= form.theme_button_style === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                  <% }); %>
                </select>
              </label>
              <div class="member-form-full">
                <button type="submit" class="primary-btn">Save</button>
              </div>
            </form>
          </div>
          <div class="homepage-builder-canvas cf-pages-canvas" data-homepage-blocks-container data-reorder-url="/main-admin/forms/<%= form.id %>/pages/reorder">
          <% pages.forEach(function(page, pageIndex) { %>
            <div class="cf-page-card" data-homepage-block-row="<%= page.id %>">
              <div class="cf-page-card-header">
                <span data-homepage-block-drag-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span>
                <h3>Page <%= pageIndex + 1 %><%= page.title ? ': ' + page.title : '' %></h3>
                <% if (page.conditionalLogicParsed) { %><span class="cf-condition-badge">Conditional</span><% } %>
                <div class="training-lesson-actions">
                  <button type="button" class="icon-btn" onclick="document.getElementById('edit-page-dialog-<%= page.id %>').showModal()" aria-label="Edit page" title="Edit Page"><svg class="icon"><use href="#icon-edit"/></svg></button>
                  <% if (pages.length > 1) { %>
                    <form method="POST" action="/main-admin/forms/<%= form.id %>/pages/<%= page.id %>/delete" class="inline-block-form" data-confirm="Remove this page? Its elements will move to the remaining page.">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete page" title="Delete Page"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  <% } %>
                </div>
              </div>
              <% if (page.description) { %><p class="hint"><%= page.description %></p><% } %>

              <% if (page.fields.length === 0) { %>
                <p class="roster-empty">No elements on this page yet.</p>
              <% } else { %>
                <div class="cf-elements-canvas" data-homepage-blocks-container data-reorder-url="/main-admin/forms/<%= form.id %>/fields/reorder" data-reorder-extra='<%- JSON.stringify({ pageId: page.id }) %>'>
                  <% page.fields.forEach(function(field) { %>
                    <div class="cf-element-row" data-homepage-block-row="<%= field.id %>">
                      <span data-homepage-block-drag-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span>
                      <span class="badge-pill badge-pill-gray cf-element-row-type"><%= fieldTypes.find(function(t) { return t.key === field.field_type; }).label %></span>
                      <strong class="cf-element-row-title"><%= field.label %></strong>
                      <% if (field.is_required == 1) { %><span class="badge-pill badge-pill-orange cf-element-row-badge">Required</span><% } %>
                      <% if (field.conditionalLogicParsed) { %><span class="cf-condition-badge cf-element-row-badge">Conditional</span><% } %>
                      <div class="cf-element-row-actions">
                        <button type="button" class="icon-btn" onclick="document.getElementById('edit-field-dialog-<%= field.id %>').showModal()" aria-label="Edit <%= field.label %>" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></button>
                        <form method="POST" action="/main-admin/forms/<%= form.id %>/fields/<%= field.id %>/delete" class="inline-block-form" data-confirm="Remove element &quot;<%= field.label %>&quot;?">
                          <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= field.label %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </form>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          <% }); %>
          </div>
        </div>

        <%# Live preview - a real request: "Live preview while editing in
            the builder itself, so an admin sees roughly what the public
            form will look like as they build it," and later: "Custom
            forms should have a live preview as you design like the
            website design page (public homepage)" (the Settings &
            Theme panel just to the left updates this instantly as you
            type/pick - public/js/custom-form-live-preview.js - which is
            also why that panel stayed on this same Details tab rather
            than moving to Settings with Assign To/Status: it needs to
            sit next to this preview, not on a separate page) and "Be
            able to click through the live preview when editing" - fields here are
            never disabled (no `disabled: true` passed to partials/
            custom-form-field.ejs) and public/js/custom-form-runtime.js
            runs the real Next/Back multi-page navigation and
            conditional-logic hide/show over this panel exactly like it
            does the real fill-out page - only the Submit button itself
            is inert (title="Preview only"). Pages/elements themselves
            still need a real Save to appear here (same as the Homepage
            editor's own content blocks, which aren't instant there
            either) - rendered from the same partial the public fill-out
            page itself uses, over the last-saved pages/fields, so it
            can never drift from what custom-forms-fill.ejs actually
            renders. %>
        <div class="cf-preview-panel no-print">
          <div class="grid-box-header"><h2>Live Preview</h2></div>
          <div class="cf-form" data-cf-form style="--cf-primary: <%= form.theme_primary_color %>; --cf-radius: <%= buttonRadius %>;">
            <h1 style="margin-top:0;" data-cf-preview-title><span data-cf-preview-emoji aria-hidden="true"<%- (currentThemePreset && currentThemePreset.emoji) ? '' : ' style="display:none"' %>><%= currentThemePreset ? currentThemePreset.emoji : '' %></span><span data-cf-preview-emoji-space><%= (currentThemePreset && currentThemePreset.emoji) ? ' ' : '' %></span><span data-cf-preview-title-text><%= form.title %></span></h1>
            <p class="hint" data-cf-preview-description<%- form.description ? '' : ' style="display:none"' %>><%= form.description || '' %></p>
            <% if (pages.length > 1) { %>
              <nav class="cf-progress" aria-label="Form progress" data-cf-progress>
                <% pages.forEach(function(page, i) { %>
                  <span class="cf-progress-step<%= i === 0 ? ' cf-progress-step-active' : '' %>" data-cf-progress-step="<%= page.id %>">
                    <span class="cf-progress-dot"><%= i + 1 %></span>
                    <span class="cf-progress-label"><%= page.title || ('Page ' + (i + 1)) %></span>
                  </span>
                <% }); %>
              </nav>
            <% } %>
            <div class="member-form-grid">
              <% pages.forEach(function(page, pageIndex) { %>
                <section
                  class="cf-page<%= pageIndex === 0 ? ' cf-page-active' : '' %>"
                  data-cf-page="<%= page.id %>"
                  data-cf-page-index="<%= pageIndex %>"
                  <% if (page.conditionalLogicParsed) { %>data-cf-condition='<%- JSON.stringify(page.conditionalLogicParsed) %>'<% } %>
                >
                  <% if (pages.length > 1 && (page.title || page.description)) { %>
                    <div class="member-form-full cf-page-heading">
                      <% if (page.title) { %><h2><%= page.title %></h2><% } %>
                      <% if (page.description) { %><p class="hint"><%= page.description %></p><% } %>
                    </div>
                  <% } %>
                  <% if (page.fields.length === 0) { %>
                    <p class="roster-empty member-form-full">No elements on this page yet.</p>
                  <% } %>
                  <% page.fields.forEach(function(field) { %>
                    <%- include('partials/custom-form-field', { field: field, ratingMax: ratingMax || { rating: 5, scale: 10 } }) %>
                  <% }); %>
                  <div class="member-form-full cf-page-nav">
                    <% if (pageIndex > 0) { %><button type="button" class="btn-secondary" data-cf-prev>&larr; Back</button><% } %>
                    <% if (pageIndex < pages.length - 1) { %>
                      <button type="button" class="primary-btn cf-btn" data-cf-next>Next &rarr;</button>
                    <% } else { %>
                      <button type="button" class="primary-btn cf-btn" disabled title="Preview only - not a real submission">Submit</button>
                    <% } %>
                  </div>
                </section>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <dialog id="add-page-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/forms/<%= form.id %>/pages">
        <h3>Add Page</h3>
        <label>Page Title
          <input type="text" name="title" placeholder="e.g. Contact Info" />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <%- include('partials/custom-form-condition-builder', { allFields: allFields, currentRule: null, conditionOperators: conditionOperators, choiceTypes: choiceTypes, excludeFieldId: null }) %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Page</button>
        </div>
      </form>
    </dialog>

    <% pages.forEach(function(page) { %>
      <dialog id="edit-page-dialog-<%= page.id %>" class="member-picker-dialog">
        <form method="POST" action="/main-admin/forms/<%= form.id %>/pages/<%= page.id %>/update">
          <h3>Edit Page</h3>
          <label>Page Title
            <input type="text" name="title" value="<%= page.title || '' %>" />
          </label>
          <label>Description
            <textarea name="description" rows="2"><%= page.description || '' %></textarea>
          </label>
          <%- include('partials/custom-form-condition-builder', { allFields: allFields, currentRule: page.conditionalLogicParsed, conditionOperators: conditionOperators, choiceTypes: choiceTypes, excludeFieldId: null }) %>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    <% }); %>

    <%# A real request: "Add page and add element button top of page,
        side by side on the same row" - one global Add Element dialog
        now instead of one per page, so it needs its own Page picker
        (defaulting to the first page) in place of the old per-page
        hidden pageId input. %>
    <dialog id="add-element-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/forms/<%= form.id %>/fields" enctype="multipart/form-data">
        <h3>Add Element</h3>
        <label>Page
          <select name="pageId">
            <% pages.forEach(function(p, i) { %>
              <option value="<%= p.id %>"><%= 'Page ' + (i + 1) + (p.title ? ': ' + p.title : '') %></option>
            <% }); %>
          </select>
        </label>
        <%# A real request, with a screenshot of Jotform's own "Form
            Elements" flyout: "Add element should be a dropdown menu of
            options and should include all of jotform's basic options
            and widget options. However the widgets won't be called
            widgets it will just be one grand list of options." Every
            entry in utils/customForms.js's own FIELD_TYPES, in that
            same order, flat - no Basic/Widgets/Payments split (this app
            has no payment-element type at all). %>
        <label>Element Type
          <select name="fieldType" data-cf-field-type-select required>
            <% fieldTypes.forEach(function(t, i) { %>
              <option value="<%= t.key %>" <%= i === 0 ? 'selected' : '' %>><%= t.label %></option>
            <% }); %>
          </select>
        </label>
        <label>Label
          <input type="text" name="label" required />
        </label>
        <label>Help Text
          <input type="text" name="helpText" />
        </label>
        <p class="hint" data-cf-row="fillblank-hint" style="display: none;">Write one sentence, with each blank marked by three or more underscores - e.g. "The capital of France is ___ and 2 + 2 = ___."</p>
        <label data-cf-row="image">Image
          <input type="file" name="image" accept="image/*" />
        </label>
        <label data-cf-row="matrix-columns">Columns (one per line)
          <textarea name="matrixColumns" rows="3"></textarea>
        </label>
        <p class="hint" data-cf-row="matrix-columns-hint" style="display: none;">Rows go in the Options box below - each becomes one question respondents answer across these columns.</p>
        <label data-cf-row="placeholder" data-cf-placeholder-label>Placeholder
          <input type="text" name="placeholder" />
        </label>
        <label data-cf-row="default">Default Value
          <input type="text" name="defaultValue" />
        </label>
        <label data-cf-row="options" style="display: none;">Options (one per line)
          <textarea name="options" rows="4"></textarea>
        </label>
        <label class="grade-pill" data-cf-row="required"><input type="checkbox" name="isRequired" /> Required</label>
        <%- include('partials/custom-form-condition-builder', { allFields: allFields, currentRule: null, conditionOperators: conditionOperators, choiceTypes: choiceTypes, excludeFieldId: null }) %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <% allFields.forEach(function(field) { %>
      <dialog id="edit-field-dialog-<%= field.id %>" class="member-picker-dialog" data-cf-field-type="<%= field.field_type %>">
        <form method="POST" action="/main-admin/forms/<%= form.id %>/fields/<%= field.id %>/update" enctype="multipart/form-data">
          <h3>Edit Element</h3>
          <p class="hint">Element Type: <%= fieldTypes.find(function(t) { return t.key === field.field_type; }).label %></p>
          <label>Page
            <select name="pageId">
              <% pages.forEach(function(p, i) { %>
                <option value="<%= p.id %>" <%= field.page_id === p.id ? 'selected' : '' %>>Page <%= i + 1 %><%= p.title ? ': ' + p.title : '' %></option>
              <% }); %>
            </select>
          </label>
          <label>Label
            <input type="text" name="label" value="<%= field.label %>" required />
          </label>
          <label>Help Text
            <input type="text" name="helpText" value="<%= field.help_text || '' %>" />
          </label>
          <p class="hint" data-cf-row="fillblank-hint" style="display: none;">Write one sentence, with each blank marked by three or more underscores - e.g. "The capital of France is ___ and 2 + 2 = ___."</p>
          <% if (field.field_type === 'image') { %>
            <label data-cf-row="image">
              <% if (field.image_path && typeof customFormImageUrl === 'function') { %><p class="hint">Current image: <img src="<%= customFormImageUrl(field.image_path) %>" alt="" class="homepage-theme-logo-preview" /></p><% } %>
              Image <span class="hint">(leave blank to keep the current one)</span>
              <input type="file" name="image" accept="image/*" />
            </label>
          <% } %>
          <% if (field.field_type === 'input_table') { %>
            <label data-cf-row="matrix-columns">Columns (one per line)
              <textarea name="matrixColumns" rows="3"><%= field.matrixColumnsParsed.join('\n') %></textarea>
            </label>
            <p class="hint">Rows are set in the Options box below - each becomes one question respondents answer across these columns.</p>
          <% } %>
          <label data-cf-row="placeholder" data-cf-placeholder-label>Placeholder
            <input type="text" name="placeholder" value="<%= field.placeholder || '' %>" />
          </label>
          <label data-cf-row="default">Default Value
            <input type="text" name="defaultValue" value="<%= field.default_value || '' %>" />
          </label>
          <% if (choiceTypes.indexOf(field.field_type) !== -1 || field.field_type === 'input_table') { %>
            <label data-cf-row="options"><%= field.field_type === 'input_table' ? 'Rows (one per line)' : 'Options (one per line)' %>
              <textarea name="options" rows="4"><%= field.options.map(function(o) { return o.label; }).join('\n') %></textarea>
            </label>
          <% } %>
          <label class="grade-pill" data-cf-row="required"><input type="checkbox" name="isRequired" <%= field.is_required == 1 ? 'checked' : '' %> /> Required</label>
          <%- include('partials/custom-form-condition-builder', { allFields: allFields, currentRule: field.conditionalLogicParsed, conditionOperators: conditionOperators, choiceTypes: choiceTypes, excludeFieldId: field.id }) %>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    <% }); %>
  </main>

  <script src="/js/homepage-block-reorder.js"></script>
  <script src="/js/custom-form-runtime.js"></script>
  <script src="/js/custom-form-signature-pad.js"></script>
  <script src="/js/custom-form-builder.js"></script>
  <script src="/js/custom-form-live-preview.js"></script>
</body>
</html>
