<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner document-view-main">
        <% if (doc.image_path) { %>
          <img class="document-view-image" src="/documents/<%= doc.public_token %>/image" alt="" />
        <% } %>
        <div class="document-view-title-row">
          <h1><%= doc.title %></h1>
          <div class="document-view-actions">
            <%- include('partials/document-actions', { doc, kind }) %>
          </div>
        </div>
        <% if (kind === 'doc') { %><p class="hint">This older Word (.doc) file can't be turned into a PDF - the download icon saves the original file.</p><% } %>
        <%- include('partials/document-body', { doc, kind, docxHtml, fileUrl: '/documents/' + doc.public_token + '/file' }) %>
      </div>
    </section>
  </main>
</body>
</html>
