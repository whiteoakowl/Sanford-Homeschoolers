<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
    // Same bug class as store-list.ejs's own comment. /accounting is open
    // to ANY signed-in portal account (not just parent/student - a
    // teacher or Main Admin can carry a charge too), so navLinks below
    // still matters as the fallback for those other roles; only the
    // portalTitle itself was the bug for a parent/student visitor.
  %>
  <%- include('partials/portal-nav', {
    portalTitle: sharedPortalTitle('Accounting'),
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/accounting', icon: 'file-text', label: 'Accounting' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# A real request: "be able to lock members and they won't be able
        to log in, unless to see and pay their account balance" - a
        locked account lands here (middleware/portalAuth.js's own
        requirePortalAuth) instead of wherever it was actually headed. %>
    <% if (locked) { %>
      <div class="alert alert-error">Your account has been locked by an administrator. You can still view and pay your balance here - contact an admin for anything else.</div>
    <% } %>
    <% if (!member) { %>
      <h1>Accounting</h1>
    <%- include('partials/help/link', { slug: 'view-your-account-balance', label: 'Accounting help' }) %>
      <p class="hint">No account on file yet.</p>
    <% } else { %>
      <div class="grid-box-header">
        <h1>Accounting</h1>
        <%- include('partials/help/link', { slug: 'view-your-account-balance', label: 'Accounting help' }) %>
      </div>
      <%# A real request: "Print button should be an icon. And pdf icons
          should both be next to account year dropdown on the same row.
          Amount due on the far right on the same row. Don't change
          mobile view." .accounting-toolbar-row is one shared flex row
          (desktop: year dropdown, Print icon, PDF icon, then the
          balance badge pushed to the far right via margin-left:auto) -
          below 641px every child keeps its original stacked order/line
          breaks (badge right under the title, then Print/PDF together,
          then the year dropdown on its own line), matching this page's
          layout before this request. %>
      <div class="accounting-toolbar-row">
        <span class="badge-pill badge-pill-<%= balanceCents > 0 ? 'orange' : 'green' %> accounting-toolbar-badge"><%= balanceCents > 0 ? formatCents(balanceCents) + ' due' : 'Paid in full' %></span>
        <%# A real request: "add print button to member account pages on
            parent portal and main admin portal" - now an icon, not a
            text button (a later real request). %>
        <a class="icon-btn accounting-toolbar-print no-print" href="/accounting/print<%= yearFilter !== 'current' ? '?year=' + yearFilter : '' %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn accounting-toolbar-pdf no-print" href="/accounting/download.pdf<%= yearFilter !== 'current' ? '?year=' + yearFilter : '' %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        <%# Same year filter as the Main Admin Account page - "current,
            all or the individual years for accounting." %>
        <form method="GET" class="accounting-toolbar-year-form no-print">
          <label>Account Year
            <select name="year" onchange="this.form.submit()">
              <option value="current" <%= yearFilter === 'current' ? 'selected' : '' %>>Current Year</option>
              <option value="all" <%= yearFilter === 'all' ? 'selected' : '' %>>All Years</option>
              <% years.forEach(function(y) { %>
                <option value="<%= y %>" <%= yearFilter === y ? 'selected' : '' %>><%= y %></option>
              <% }); %>
            </select>
          </label>
        </form>
      </div>

      <%# A real request: "Build the connection" (Stripe). Pay Now: pick
          open charges and pay them by card on Stripe's own secure page,
          plus the card processing fee ("Members will pay the card fees").
          Only shown once online payments are set up and turned on. %>
      <% if (paymentNotice === 'success') { %><div class="alert alert-success">Thank you! Your payment went through and your account is updated.</div><% } %>
      <% if (paymentNotice === 'processing') { %><div class="alert alert-info">Thank you! Your payment is processing - your account will update in a few minutes.</div><% } %>
      <% if (paymentNotice === 'cancelled') { %><div class="alert alert-info">Payment cancelled - nothing was charged.</div><% } %>
      <% if (paymentError) { %><div class="alert alert-error"><%= paymentError %></div><% } %>
      <% if (onlineEnabled && payableCharges.length) { %>
        <section class="manage-section pay-now no-print">
          <div class="grid-box-header"><h2><svg class="icon"><use href="#icon-coin"/></svg> Pay Online</h2></div>
          <form method="POST" action="/accounting/pay" class="pay-now-form" data-fee-percent="<%= cardFee.percent %>" data-fee-fixed="<%= cardFee.fixedCents %>">
            <ul class="pay-now-list">
              <% payableCharges.forEach(function(c) { %>
                <li>
                  <label class="pay-now-item">
                    <input type="checkbox" name="chargeIds" value="<%= c.id %>" data-cents="<%= c.owedCents %>" checked />
                    <span class="pay-now-desc"><%= c.description %></span>
                    <span class="pay-now-amount"><%= formatCents(c.owedCents) %></span>
                  </label>
                </li>
              <% }); %>
            </ul>
            <div class="pay-now-totals">
              <div><span>Selected</span><strong data-pay-subtotal></strong></div>
              <div><span>Card processing fee</span><strong data-pay-fee></strong></div>
              <div class="pay-now-total"><span>Total</span><strong data-pay-total></strong></div>
            </div>
            <p class="hint">You'll pay on Stripe's secure checkout page. A card processing fee (<%= cardFee.percent %>% + <%= (cardFee.fixedCents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>) is added so the co-op receives the full amount.</p>
            <button type="submit" class="primary-btn pay-now-btn" data-pay-button>Pay Now</button>
          </form>
        </section>
        <script src="/js/pay-now.js"></script>
      <% } %>

      <div class="manage-section">
        <div class="grid-box-header"><h2>Invoices</h2></div>
        <% if (invoices.length === 0) { %>
          <p class="roster-empty">No invoices for this period.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table accounting-table-mobile-fit table-stack-mobile">
              <thead>
                <tr>
                  <th>Description</th>
                  <th>Amount</th>
                  <th>Paid</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(function(c) { %>
                  <tr>
                    <td class="table-stack-heading"><%= c.description %></td>
                    <td data-label="Amount"><%= formatCents(c.amount_cents) %></td>
                    <td data-label="Paid"><%= formatCents(c.amountPaid) %></td>
                    <td data-label="Status"><span class="badge-pill badge-pill-<%= c.status === 'paid' ? 'green' : c.status === 'cancelled' || c.status === 'refunded' ? 'gray' : 'orange' %>"><%= c.status.replace('_', ' ') %></span></td>
                    <td data-label="Date"><%= c.dateLabel %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="accounting-section-total">Total: <%= formatCents(invoicesTotalCents) %></p>
        <% } %>
      </div>

      <div class="manage-section">
        <div class="grid-box-header"><h2>Payments</h2></div>
        <% if (paymentRows.length === 0) { %>
          <p class="roster-empty">No payments for this period.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table accounting-table-mobile-fit table-stack-mobile">
              <thead>
                <tr>
                  <th>For</th>
                  <th>Amount</th>
                  <th>Note</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% paymentRows.forEach(function(p) { %>
                  <tr>
                    <td class="table-stack-heading"><%= p.chargeDescription %></td>
                    <td data-label="Amount"><%= formatCents(p.amount_cents) %></td>
                    <td data-label="Note"><%= p.note || '' %></td>
                    <td data-label="Date"><%= p.dateLabel %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="accounting-section-total">Total: <%= formatCents(paymentsTotalCents) %></p>
        <% } %>
      </div>

      <div class="manage-section">
        <div class="grid-box-header"><h2>Adjustments, Credits &amp; Refunds</h2></div>
        <% if (refundRows.length === 0 && cancelledCharges.length === 0) { %>
          <p class="roster-empty">No adjustments for this period.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table accounting-table-mobile-fit table-stack-mobile">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>For</th>
                  <th>Amount</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% refundRows.forEach(function(p) { %>
                  <tr>
                    <td class="table-stack-heading"><span class="badge-pill badge-pill-gray">Refund</span></td>
                    <td data-label="For"><%= p.chargeDescription %></td>
                    <td data-label="Amount"><%= formatCents(p.amount_cents) %></td>
                    <td data-label="Date"><%= p.dateLabel %></td>
                  </tr>
                <% }); %>
                <% cancelledCharges.forEach(function(c) { %>
                  <tr>
                    <td class="table-stack-heading"><span class="badge-pill badge-pill-gray">Cancelled Charge</span></td>
                    <td data-label="For"><%= c.description %></td>
                    <td data-label="Amount"><%= formatCents(c.amount_cents) %></td>
                    <td data-label="Date"><%= c.dateLabel %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="accounting-section-total">Total: <%= formatCents(adjustmentsTotalCents) %></p>
        <% } %>
      </div>
    <% } %>
  </main>
</body>
</html>
