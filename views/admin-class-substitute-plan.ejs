<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/class-schedule/classes/<%= cls.id %>/manage?tab=assignments">&larr; <%= cls.class_name %> Lessons</a></p>
    <h1><%= cls.class_name %> Substitute Plans</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <%- include('partials/substitute-plan-manage', { basePath, plans, openPlanId }) %>
  </main>
</body>
</html>
