<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: navPortalTitle }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Settings</h1>

    <%# A real request: "All portals settings gear. [They] are all now
        the card setup." Student Portal and Co-op Teacher Portal didn't
        have a card-view gear hub at all before this - their gear just
        opened the bare generic account-settings page (views/portal-
        settings.ejs). Same .team-card-grid/.team-info-card component
        every other portal's own hub already uses - My Privacy is the
        one thing there is to show today, same as it always was, just
        presented as a card now instead of a one-row list. %>
    <div class="team-card-grid settings-hub-card-grid">
      <div class="team-col">
        <a class="team-info-card" href="/portal/settings">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-lock"/></svg></span>
          <h3 class="team-info-title">My Privacy</h3>
        </a>
      </div>
      <%# A real request: "Download app should be included in the settings
          gears of all portals, all." Same shared /portal/install-app page
          (routes/portal-auth.js) every other portal's own Settings hub now
          links to. This hub itself is shared by Student and Co-op Teacher
          Portal, but Student Portal deliberately has no settings gear of
          its own (a real request: "Student Portal should not have a
          settings gear" - portal-nav.ejs's own showSettingsGear), so this
          card is only ever actually reachable via Co-op Teacher Portal's
          own gear in practice. %>
      <div class="team-col">
        <a class="team-info-card" href="/portal/install-app">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-download"/></svg></span>
          <h3 class="team-info-title">Download App</h3>
        </a>
      </div>
    </div>
  </main>
</body>
</html>
