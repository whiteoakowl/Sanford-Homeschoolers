<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%# Parent Portal > Co-op Classes > Schedule Change Request (routes/parent-
    portal.js, utils/scheduleChange.js). Each child: current classes with
    a Cancel box, then classes with room to add; a note; past requests
    and how each class was decided. %>
<% var statusLabel = { pending: 'Waiting for admin', approved: 'Approved', partial: 'Approved (some additions declined)', declined: 'Declined' }; %>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Schedule Change Request</h1>
    <p class="subtitle">Choose the classes to cancel and the classes to add. A co-op admin approves the switch - nothing changes until then.</p>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (kids.length === 0) { %>
      <p class="roster-empty">No students are linked to your account yet.</p>
    <% } else { %>
      <form method="POST" action="/parent/classes/schedule-change" class="sc-form">
        <% kids.forEach(function(k) { %>
          <section class="manage-section sc-student">
            <h2><%= k.child.name %></h2>
            <h3 class="sc-sub">Current Classes</h3>
            <% if (k.current.length === 0) { %>
              <p class="hint">Not in any classes right now.</p>
            <% } else { %>
              <ul class="sc-list">
                <% k.current.forEach(function(c) { %>
                  <li>
                    <span class="sc-class"><strong><%= c.class_name %></strong> <span class="hint"><%= dayLabels[c.day] || c.day %> &middot; <%= c.timeLabel || ('Hour ' + c.hour_position) %><%= c.room ? ' · ' + c.room : '' %></span></span>
                    <label class="sc-cancel"><input type="checkbox" name="drop" value="<%= k.child.id %>:<%= c.id %>" /> Cancel</label>
                  </li>
                <% }); %>
              </ul>
            <% } %>
            <h3 class="sc-sub">Add Classes <span class="hint">(classes with room)</span></h3>
            <% if (k.available.length === 0) { %>
              <p class="hint">No classes with open seats right now.</p>
            <% } else { %>
              <ul class="sc-list">
                <% k.available.forEach(function(c) { %>
                  <li>
                    <label class="sc-add">
                      <input type="checkbox" name="add" value="<%= k.child.id %>:<%= c.id %>" />
                      <span class="sc-class"><strong><%= c.class_name %></strong> <span class="hint"><%= dayLabels[c.day] || c.day %> &middot; <%= c.timeLabel || ('Hour ' + c.hour_position) %><%= c.room ? ' · ' + c.room : '' %></span></span>
                    </label>
                    <span class="sc-spots"><%= c.spotsLeft == null ? 'Open' : c.spotsLeft + ' spot' + (c.spotsLeft === 1 ? '' : 's') + ' left' %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </section>
        <% }); %>
        <label class="sc-note">Note to admins <span class="hint">(optional)</span>
          <textarea name="note" rows="3"></textarea>
        </label>
        <button type="submit" class="primary-btn">Send Request</button>
      </form>
    <% } %>

    <% if (history.length) { %>
      <h2 class="sc-history-title">Your Requests</h2>
      <% history.forEach(function(r) { %>
        <div class="manage-section sc-history">
          <p><strong><%= r.requestedLabel %></strong> &middot; <span class="sc-status sc-status-<%= r.status %>"><%= statusLabel[r.status] || r.status %></span></p>
          <ul class="sc-item-list">
            <% r.items.forEach(function(i) { %>
              <li><%= i.action === 'drop' ? 'Cancel' : 'Add' %>: <%= i.student_name %> &ndash; <%= i.classLabel %><% if (i.result) { %> <span class="hint">(<%= i.result %>)</span><% } %></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } %>
  </main>
</body>
</html>
