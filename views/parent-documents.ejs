<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Documents</h1>

    <% if (documents.length === 0) { %>
      <p class="roster-empty">No documents have been shared yet.</p>
    <% } else { %>
      <%
        var docColors = ['landing-card-orange', 'landing-card-purple', 'landing-card-green'];
      %>
      <div class="landing-grid documents-grid landing-card-rect">
        <% documents.forEach(function(d, i) { %>
          <div class="document-card-wrap document-card-wrap-actions">
            <a class="landing-card <%= docColors[i % docColors.length] %>" href="/documents/<%= d.public_token %>">
              <% if (d.image_path) { %>
                <img class="landing-card-image" src="/documents/<%= d.public_token %>/image" alt="" />
              <% } else { %>
                <span class="landing-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
              <% } %>
              <span class="landing-label"><%= d.title %></span>
            </a>
            <%# Print/PDF icons - siblings of the card's own <a> (never
                nested inside it), so clicking one never also opens the
                document's view page. %>
            <div class="document-card-actions">
              <%- include('partials/document-actions', { doc: d, kind: d.kind, extraClass: 'document-card-action-btn' }) %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
