<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Co-op Teacher Portal' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/teacher/reimbursements">&larr; Reimbursements</a></p>
    <h1><%= cls.className %></h1>
    <%- include('partials/class-fees-table', { classes: [cls], totals: null, classLinkBase: null }) %>

    <h2 class="reimbursement-items-heading">Reimbursement Submissions</h2>
    <% if (requests.length === 0) { %>
      <p class="roster-empty">No reimbursement forms have been submitted for this class yet.</p>
    <% } else { %>
      <table class="roster-table condensed-table reimbursement-log-table">
        <thead>
          <tr><th>Submitted</th><th>Name</th><th>Items</th><th>Receipts</th><th class="reimbursement-amount-col">Total</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% requests.forEach(function(r) { %>
            <tr data-class-request="<%= r.id %>">
              <td><a href="/teacher/reimbursements/<%= r.id %>"><%= formatTimestamp(r.submitted_at) %></a></td>
              <td><%= r.member_name %></td>
              <td><%= r.itemCount %></td>
              <td><%= r.receiptCount %></td>
              <td class="reimbursement-amount-col"><%= r.totalLabel %></td>
              <td><span class="badge-pill <%= { submitted: 'badge-pill-orange', approved: 'badge-pill-green', rejected: 'badge-pill-red' }[r.status] || 'badge-pill-gray' %>"><%= r.statusLabel %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
