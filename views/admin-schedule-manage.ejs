<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/schedule?tab=members&type=<%= returnType %>">&larr; All Schedules</a></p>
    <div class="roster-toolbar no-print">
      <p class="hint">Generated automatically from the Class Schedule - enroll or staff <%= member.name %> on a class there to change what shows up here.</p>
      <%- include('partials/member-schedule-actions', {
        exportHref: '/admin/schedule/export.csv?memberId=' + member.id,
        pdfHref: '/admin/schedule/download.pdf?memberId=' + member.id,
        printHref: '/admin/schedule/print?memberId=' + member.id,
      }) %>
    </div>

    <%- include('partials/member-schedule-table', { tables: scheduleTables, headingLevel: 1, classHref: function (id) { return '/admin/class-schedule/classes/' + id + '/manage'; } }) %>
  </main>
</body>
</html>
