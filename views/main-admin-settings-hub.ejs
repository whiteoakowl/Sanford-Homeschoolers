<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Settings</h1>

    <%# A real request: "clicking on the settings tab should not show
        subpages. instead all subpages should be rows of cards for each
        setting category" - the gear used to open a .portal-switcher-
        details dropdown of 4 links (Roles & Permissions/Website/Audit
        Log/Co-op Admin Portal, missing Admins/FAQ/Quick Links entirely);
        this lists every one of them as its own card instead, same
        .team-card-grid/.team-info-card component every other "pick one
        of these named things" page in this app already uses (Training,
        Classifieds categories, Shop products). %>
    <div class="team-card-grid settings-hub-card-grid">
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/roles">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-shield"/></svg></span>
          <h3 class="team-info-title">Portal Permissions</h3>
        </a>
      </div>
      <%# A real request: "The main admin portal is now where the master
          lives." Changes the signed-in Main Admin account's own login
          email/password (routes/main-admin.js's /admin-login). %>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/admin-login">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-user-circle"/></svg></span>
          <h3 class="team-info-title">Admin Login</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/admins">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-user-check"/></svg></span>
          <h3 class="team-info-title">Admins</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/website">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-sliders"/></svg></span>
          <h3 class="team-info-title">Public Homepage</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/faq">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-info-circle"/></svg></span>
          <h3 class="team-info-title">FAQ</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/quick-links">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-link"/></svg></span>
          <h3 class="team-info-title">Quick Links</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/register" target="_blank">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-user-check"/></svg></span>
          <h3 class="team-info-title">Request Membership Form</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/privacy-policy" target="_blank">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-shield"/></svg></span>
          <h3 class="team-info-title">Privacy Policy</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/terms-and-conditions" target="_blank">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
          <h3 class="team-info-title">Terms and Conditions</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/documents">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
          <h3 class="team-info-title">Documents</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/notifications">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-mail"/></svg></span>
          <h3 class="team-info-title">Text/Email Notifications</h3>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/main-admin/audit-log">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
          <h3 class="team-info-title">Audit Log</h3>
        </a>
      </div>
      <%# A real request: "Download app should be included in the settings
          gears of all portals, all." Links to the same shared, account-
          agnostic Install App page (routes/portal-auth.js's own /portal/
          install-app) every other portal's own Settings hub now links to
          - this content has nothing Co-op Admin-specific about it, so it
          doesn't require a separate login the way Admin Login above does. %>
      <div class="team-col">
        <a class="team-info-card" href="/portal/install-app">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-download"/></svg></span>
          <h3 class="team-info-title">Download App</h3>
        </a>
      </div>
    </div>
  </main>
</body>
</html>
