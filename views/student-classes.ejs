<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <%# A real request: "This page should show the entire schedules that
      are listed on parent portal. For example if currently is shows
      fall Monday and fall Wednesday classes, those class grids should
      appear on this page. This is not the page to view the classes the
      student is registered for. It is for viewing the current class
      schedules of classes available." Same semester/day/grid-list
      controls and read-only Room x Hour grid as Parent Portal's own
      Class Registration page (routes/parent-portal.js's own GET
      /classes, views/parent-classes.ejs) - same data-fetching functions
      (utils/classSchedule.js) and the same views/partials/member-class-
      schedule-grid.ejs grid markup, just with nothing registration-
      specific: no Register/Cancel actions (clickable: false - students
      don't self-register from this page), no Filter-by-grade/student
      panel (a parent-family-specific filter), no "Classes Needing a
      Teacher or Assistant" button. %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Co-op Schedule</h1>

    <%
      const semesterQuery = selectedSemesterId ? `&semesterId=${selectedSemesterId}` : '';
    %>
    <%# A real request: "Add export, print and pdf icons. In a row, not
        a column, clean side by side. This row should be at the top
        under title." Its own row, not folded into the semester/view-
        toggle/day-toggle filter-row below it - same icon-row convention
        as every other schedule-shaped page (e.g. Co-op Teacher Portal's
        own /teacher/classes). %>
    <div class="co-op-schedule-file-icons no-print">
      <a class="icon-btn" href="/student/classes/export.csv?day=<%= day %><%= semesterQuery %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
      <a class="icon-btn" href="/student/classes/print?day=<%= day %><%= semesterQuery %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
      <a class="icon-btn" href="/student/classes/download.pdf?day=<%= day %><%= semesterQuery %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
    </div>

    <div class="filter-row no-print">
      <div class="category-filter">
        <label for="student-schedule-semester-select">Semester</label>
        <select id="student-schedule-semester-select" onchange="window.fullscreenNavigate(this.value)">
          <option value="/student/classes?day=<%= day %>&view=<%= view %>" <%= selectedSemesterId === null ? 'selected' : '' %>>All Semesters</option>
          <% semesters.forEach(function(s) { %>
            <option value="/student/classes?day=<%= day %>&view=<%= view %>&semesterId=<%= s.id %>" <%= selectedSemesterId === s.id ? 'selected' : '' %>><%= s.title %></option>
          <% }); %>
        </select>
      </div>
      <div class="class-schedule-view-toggle" role="group" aria-label="Grid or list view">
        <a class="icon-btn<%= view === 'grid' ? ' icon-btn-active' : '' %>" href="/student/classes?day=<%= day %>&view=grid<%= semesterQuery %>" aria-pressed="<%= view === 'grid' %>" aria-label="Grid view" title="Grid view"><svg class="icon"><use href="#icon-grid"/></svg></a>
        <a class="icon-btn<%= view === 'list' ? ' icon-btn-active' : '' %>" href="/student/classes?day=<%= day %>&view=list<%= semesterQuery %>" aria-pressed="<%= view === 'list' %>" aria-label="List view" title="List view"><svg class="icon"><use href="#icon-clipboard-list"/></svg></a>
      </div>
      <div class="day-toggle schedule-day-toggle">
        <% activeDays.forEach(function (d) { %>
          <a class="day-toggle-option<%= day === d ? ' active' : '' %>" href="/student/classes?day=<%= d %>&view=<%= view %><%= semesterQuery %>"><%= dayLabels[d] %></a>
        <% }); %>
      </div>
    </div>

    <%- include('partials/member-class-schedule-grid', {
      roomGrid,
      classList,
      day,
      view,
      enrolledClassIds,
      clickable: true,
      registeredTitle: 'You are enrolled in this class',
    }) %>
  </main>

  <%# Shrinks a long class title to fit its own grid cell/card, same as
      Parent Portal's own identical grid (public/js/shrink-title-to-fit.js
      - a generic measure-and-shrink helper, not registration-specific). %>
  <script src="/js/shrink-title-to-fit.js"></script>
  <%# A real request: "Student portal, co-op schedule, should be able to
      click on each class and view the information, student is not able
      to register for classes." clickable: true above wires each card
      with the same data-view-class attribute Co-op Teacher Portal's own
      identical grid uses - this dialog/script pair is the read-only
      info popup, never a register/cancel form. %>
  <dialog id="student-class-dialog" class="parent-class-dialog"></dialog>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/student-class-view.js"></script>
</body>
</html>
