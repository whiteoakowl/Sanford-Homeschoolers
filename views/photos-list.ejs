<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%
  // Same fix as directory-list.ejs's own comment.
  const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'parent');
  const hasStudentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
  // A real request moved Photos into Co-op Teacher Portal's own main nav
  // (portal-nav.ejs's own TEACHER_NAV_LINKS) - a teacher-only account
  // used to fall through to the plain public shell below (neither
  // hasParentRole nor hasStudentRole), the exact same "lost their
  // dashboard menus" bug already fixed for Chat/other shared pages.
  const hasTeacherRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'teacher');
  const usesPortalNavShell = hasParentRole || hasStudentRole || hasTeacherRole;
%>
<body>
  <% if (usesPortalNavShell) { %>
    <%
      // A real bug report: "Student portal, when you click on chat it
      // should stay on Student portal" was this exact same "always
      // guess Parent first" mistake, just for Photos instead of Chat -
      // sharedPortalTitle (middleware/portalAuth.js) now also honors
      // ?portal=parent|student|teacher when it's present (see
      // portal-nav.ejs's own Photos href), so a dual-role account keeps
      // whichever portal they actually clicked from instead of always
      // landing in Parent.
    %>
    <%- include('partials/portal-nav', { portalTitle: sharedPortalTitle(hasParentRole ? 'Parent Portal' : hasStudentRole ? 'Student Portal' : 'Co-op Teacher Portal') }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (usesPortalNavShell) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <div class="grid-box-header">
          <h1>Photos</h1>
          <% if (typeof portalAccount !== 'undefined' && portalAccount && albums.length > 0) { %>
            <a class="roster-action-btn" href="/photos/add">+ Add Photo</a>
          <% } %>
        </div>

        <% if (albums.length === 0) { %>
          <p class="roster-empty">No albums yet.</p>
        <% } else { %>
          <div class="event-card-grid">
            <% albums.forEach(function(a) { %>
              <a class="event-card" href="/photos/<%= a.id %>">
                <% if (a.cover_image_key) { %>
                  <div class="event-card-image"><img src="/photos/<%= a.id %>/cover" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <h3><%= a.title %></h3>
                  <% if (a.description) { %><p class="event-card-location"><%= a.description %></p><% } %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%
    // A real request: "when you click the photos tab it goes to a
    // completely different page than the whole dashboard. It should
    // look like other pages with an add photo button." A later request:
    // "Add photo button should also allow you to upload multiple photos
    // at once. This should not be a pop up. It should be an page with a
    // back button." - the album-picker + multi-file upload form that
    // used to live in a <dialog> here now lives on its own page,
    // views/photos-add.ejs, which posts to that exact same
    // /photos/:id/upload route (members can add photos to an existing
    // album, never create one - see routes/photos.js's own comment on
    // why there's no create-album route here at all).
  %>
</body>
</html>
