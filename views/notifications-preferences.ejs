<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Notifications',
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/notifications/preferences', icon: 'sliders', label: 'Preferences' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Notification Preferences</h1>
    <%- include('partials/help/link', { slug: 'notification-preferences', label: 'Notification help' }) %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <section class="team-info-card" id="push-device-card" style="margin-bottom: 1rem;" data-public-key="<%= pushConfigured ? pushPublicKey : '' %>">
      <h2>Push notifications on this device</h2>
      <p class="hint">Get alerts on this phone, tablet or computer, even when the site isn't open. Turn it on separately on each device you use.<% if (pushDeviceCount > 0) { %> You have push on for <%= pushDeviceCount %> device<%= pushDeviceCount === 1 ? '' : 's' %>.<% } %></p>
      <p id="push-device-status" role="status" aria-live="polite"><%= pushConfigured ? 'Checking this device...' : 'Push notifications are not set up on this site yet.' %></p>
      <div class="notes-dialog-actions">
        <button type="button" class="primary-btn" id="push-enable-btn" hidden>Turn on for this device</button>
        <button type="button" class="btn-secondary" id="push-disable-btn" hidden>Turn off for this device</button>
        <button type="button" class="btn-secondary" id="push-test-btn" hidden>Send a test</button>
      </div>
    </section>

    <form method="POST" action="/notifications/preferences">
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr><th>Type</th><th>Email</th><th>Text</th><th>Push</th></tr>
          </thead>
          <tbody>
            <% preferences.forEach(function(p) { %>
              <tr>
                <td><%= p.type.label %><br /><span class="hint"><%= p.type.description %></span></td>
                <%# A real request: several types are text-only or
                    email-only by design (see utils/notifications.js's
                    own notify() - email_enabled/sms_enabled), not just
                    by this account's own preference - greyed out
                    instead of hidden, so it's clear this isn't
                    something the member can turn on. %>
                <td>
                  <% if (p.type.email_enabled) { %>
                    <input type="checkbox" name="email_<%= p.type.key %>" value="1" <%= p.email ? 'checked' : '' %> />
                  <% } else { %>
                    <span class="hint" title="This notification type is always text-only.">N/A</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.type.sms_enabled) { %>
                    <input type="checkbox" name="sms_<%= p.type.key %>" value="1" <%= p.sms ? 'checked' : '' %> />
                  <% } else { %>
                    <span class="hint" title="This notification type is always email-only.">N/A</span>
                  <% } %>
                </td>
                <%# Push goes to every device where this member turned
                    push on (card above) - see utils/pushProvider.js. %>
                <td><input type="checkbox" name="push_<%= p.type.key %>" value="1" <%= p.push ? 'checked' : '' %> /></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <button type="submit" class="primary-btn">Save</button>
    </form>
  </main>
  <script src="/js/push-notifications.js" defer></script>
</body>
</html>
