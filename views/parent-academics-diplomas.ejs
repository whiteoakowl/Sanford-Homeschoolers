<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Diplomas</h1>
    <p class="hint">Choose a design, fill in the details, pick a seal and who signs it, then press Update Preview to see your changes. Each student has one diploma.</p>

    <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (!rec) { %>
      <p class="roster-empty">No students are linked to your family yet. Contact an admin if this looks wrong.</p>
    <% } else { %>
      <% if (children.length > 1) { %>
        <div class="manage-section no-print">
          <label>Student
            <select onchange="window.location.href = '/parent/academics/diplomas?studentId=' + this.value">
              <% children.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= rec.child.id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
        </div>
      <% } %>
      <%- include('partials/diploma-student-builder', { rec, todayISO, familySettings, basePath: '/parent/academics/diplomas' }) %>
    <% } %>
  </main>
  <script src="/js/diploma-designer.js"></script>
</body>
</html>
