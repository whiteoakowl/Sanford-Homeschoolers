<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap form-wrap-roster">
    <div class="form-outer-panel">
      <div class="class-checkin-attendance-header">
        <a href="/kiosk/class-checkin/classes/<%= cls.day %>" class="kiosk-home kiosk-home-inline">&larr; Back to <%= cls.dayLabel %> Classes</a>
        <%# A real request: the class QR code "won't just be for check
            in" - View Lesson Plan and View Substitute Plan side by side
            above Check In/Check Out. %>
        <div class="class-checkin-action-stack">
        <div class="class-checkin-actions">
          <a class="class-checkin-btn class-checkin-btn-plan" href="/kiosk/class-checkin/classes/<%= cls.id %>/lesson-plan">
            <svg class="icon"><use href="#icon-clipboard-list"/></svg> View Lesson Plan
          </a>
          <a class="class-checkin-btn class-checkin-btn-plan" href="/kiosk/class-checkin/classes/<%= cls.id %>/substitute-plan">
            <svg class="icon"><use href="#icon-book"/></svg> View Substitute Plan
          </a>
        </div>
        <div class="class-checkin-actions">
          <a class="class-checkin-btn" href="/kiosk/class-checkin/classes/<%= cls.id %>/scan?mode=checkin">
            <svg class="icon"><use href="#icon-check"/></svg> Check In
          </a>
          <a class="class-checkin-btn" href="/kiosk/class-checkin/classes/<%= cls.id %>/scan?mode=checkout">
            <svg class="icon"><use href="#icon-log-out"/></svg> Check Out
          </a>
        </div>
        </div>
      </div>
      <h1><%= cls.class_name %> Attendance</h1>

      <%- include('partials/class-attendance-grid', { rows, dateLabels, summary, endpoint: '/kiosk/class-checkin/classes/' + cls.id + '/attendance' }) %>
    </div>
  </main>
  <script src="/js/attendance-grid.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
