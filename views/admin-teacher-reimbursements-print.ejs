<!doctype html>
<html lang="en">
<head>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter landscape; margin: 0.4in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Teacher Reimbursements</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub">Teacher Reimbursements<%= filterLabel ? ' - ' + filterLabel : '' %></p>
        </div>
      </div>

      <table class="roster-table condensed-table logs-print-table reimbursement-log-table">
        <thead>
          <tr>
            <th>Submitted</th><th>Name</th><th>Semester</th><th>Day</th><th>Class</th><th>Items</th><th>Receipts</th><th class="reimbursement-amount-col">Total</th><th>Status</th><th>Check #</th><th>Check Date</th><th>Approved By</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr><td colspan="12" class="roster-empty">No reimbursement forms.</td></tr>
          <% } %>
          <% requests.forEach(function(r) { %>
            <tr>
              <td><%= formatTimestamp(r.submitted_at) %></td>
              <td><%= r.member_name %></td>
              <td><%= r.semester_title %></td>
              <td><%= r.dayLabel %></td>
              <td><%= r.class_name %></td>
              <td><%= r.itemCount %></td>
              <td><%= r.receiptCount %></td>
              <td class="reimbursement-amount-col"><%= r.totalLabel %></td>
              <td><%= r.statusLabel %></td>
              <td><%= r.check_number || '' %></td>
              <td><%= r.check_date ? formatDateShort(r.check_date) : '' %></td>
              <td><%= r.approved_by_name || '' %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot><tr><th colspan="7">Total</th><th class="reimbursement-amount-col"><%= grandTotalLabel %></th><th colspan="4"></th></tr></tfoot>
      </table>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
