<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar">
      <div><h1>Classroom Dashboard</h1></div>
      <%# A real request: "At the top add a button that says Withdraw from
          co-op classes. A popup occurs and asks are you sure you want to
          delete your enrollment to co-op and cancel all of your students
          classes? Option to add a note to admins. Confirm and cancel
          buttons." Only a request - admins confirm it (routes/admin-
          coop-withdraw.js). %>
      <% if (!pendingWithdrawal) { %>
        <div class="roster-btn-row no-print">
          <button type="button" class="roster-action-btn roster-action-btn-danger" onclick="document.getElementById('coop-withdraw-dialog').showModal()"><svg class="icon"><use href="#icon-log-out"/></svg> Withdraw from Co-op Classes</button>
        </div>
      <% } %>
    </div>
    <% if (withdrawNotice) { %><div class="alert alert-success"><%= withdrawNotice %></div><% } %>
    <% if (pendingWithdrawal) { %>
      <div class="alert alert-info">Your request to withdraw from co-op classes is waiting for a co-op admin to review it. Your family's classes stay as they are until then.</div>
    <% } %>
    <dialog id="coop-withdraw-dialog" class="member-picker-dialog">
      <form method="POST" action="/parent/classes/withdraw">
        <h3>Withdraw from Co-op Classes</h3>
        <p>Are you sure you want to delete your enrollment to co-op and cancel all of your students' classes?</p>
        <label>Note to admins <span class="hint">(optional)</span>
          <textarea name="note" rows="3" placeholder="Anything you'd like the admins to know"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Confirm</button>
        </div>
      </form>
    </dialog>
    <div id="classroom-dashboard-status" class="alert alert-error no-print" hidden></div>

    <% if (children.length === 0 && parents.length === 0) { %>
      <p class="roster-empty">No family members are linked to your account yet. Contact an admin if this looks wrong.</p>
    <% } else { %>
      <%
        var selectedPerson = selectedChild || selectedParent;
        var selectedValue = selectedChild ? ('student-' + selectedChild.id) : selectedParent ? ('parent-' + selectedParent.id) : '';
      %>
      <%# A real request: "Classroom dashboard on parent portal should
          have Parent names in drop down menu to show what classes the
          parent is teaching or assisting in" - the dashboard's original
          request ("a dropdown menu... with each family member to choose
          view") already called for every family member, so this one
          picker now covers both children (viewing their enrolled
          classes) and parents (viewing the classes they teach/assist). %>
      <form method="GET" action="/parent/classes/dashboard" class="class-dash-picker-form">
        <label class="member-form-full">Viewing classes for
          <select name="viewer" onchange="this.form.submit()">
            <% if (children.length) { %>
              <optgroup label="Children">
                <% children.forEach(function(c) { %>
                  <option value="student-<%= c.id %>" <%= selectedValue === ('student-' + c.id) ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </optgroup>
            <% } %>
            <% if (parents.length) { %>
              <optgroup label="Parents">
                <% parents.forEach(function(p) { %>
                  <option value="parent-<%= p.id %>" <%= selectedValue === ('parent-' + p.id) ? 'selected' : '' %>><%= p.name %></option>
                <% }); %>
              </optgroup>
            <% } %>
          </select>
        </label>
        <noscript><button type="submit" class="roster-action-btn">Go</button></noscript>
      </form>

      <% if (days.length === 0) { %>
        <p class="roster-empty">
          <% if (selectedParent) { %>
            <%= selectedParent.name %> isn't teaching or assisting in any classes yet.
          <% } else { %>
            <%= selectedPerson.name %> isn't enrolled in any classes yet.
          <% } %>
        </p>
      <% } else { %>
        <% days.forEach(function(d) { %>
          <h2><%= dayLabels[d] %></h2>
          <div class="class-dash-grid parent-class-dash-grid">
            <% byDay[d].forEach(function(c) { %>
              <%- include('partials/class-dash-card', { c: c, selectedChild: selectedChild, selectedParent: selectedParent }) %>
            <% }); %>
          </div>
        <% }); %>
      <% } %>
    <% } %>
  </main>
  <script src="/js/classroom-dashboard-withdraw.js"></script>
</body>
</html>
