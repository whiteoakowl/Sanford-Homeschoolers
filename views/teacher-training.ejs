<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Co-op Teacher Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Training</h1>

    <% if (assignments.length === 0) { %>
      <p class="roster-empty">You don't have any assigned training right now.</p>
    <% } else { %>
      <div class="training-card-grid">
        <% assignments.forEach(function(a) { %>
          <%- include('partials/training-card', { a }) %>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
